<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.FinanceiroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:InovaLog.ViewModels"
    x:DataType="vm:FinanceiroViewModel"
    BackgroundColor="#F8F8F8"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!--  CABEÇALHO AZUL  -->
        <Grid
            Grid.Row="0"
            Padding="30,10,15,5"
            ColumnDefinitions="*,Auto"
            HeightRequest="85"
            RowDefinitions="Auto">

            <Grid.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                    <GradientStop Offset="1.0" Color="#1EA1E8" />
                    <GradientStop Offset="0.0" Color="#2C63B1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Label
                Grid.Row="0"
                Grid.Column="0"
                FontFamily="PoppinsSemiBold"
                FontSize="31"
                HorizontalOptions="Start"
                Text="Financeiro"
                TextColor="White"
                VerticalOptions="Center" />

            <Image
                Grid.Row="0"
                Grid.Column="1"
                HeightRequest="70"
                HorizontalOptions="End"
                Source="logo_azul.png"
                VerticalOptions="Center"
                WidthRequest="70" />

        </Grid>

        <!--  CONTEÚDO  -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20,20,20,25"
                HorizontalOptions="Center"
                Spacing="18">

                <!--  SALDO ACUMULADO  -->
                <Border
                    Padding="18"
                    BackgroundColor="White"
                    Stroke="#CCCDC6"
                    StrokeShape="RoundRectangle 18"
                    StrokeThickness="1">

                    <VerticalStackLayout Spacing="8">

                        <Grid Margin="0,10" ColumnDefinitions="*,Auto">

                            <!--  SALDO ACUMULADO  -->
                            <Label
                                Grid.Column="0"
                                FontFamily="PoppinsMedium"
                                FontSize="12"
                                Text="Saldo Acumulado do Mês"
                                TextColor="#64748B"
                                VerticalOptions="Center" />

                            <Border
                                Grid.Column="1"
                                Padding="10,5"
                                BackgroundColor="#E0F2FE"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0">

                                <!--  MÊS  -->
                                <Label
                                    FontFamily="PoppinsSemiBold"
                                    FontSize="11"
                                    Text="{Binding MesReferencia}"
                                    TextColor="#2C63B1" />

                            </Border>

                        </Grid>

                        <!--  SALDO  -->
                        <Label
                            FontFamily="PoppinsBold"
                            FontSize="30"
                            Text="{Binding SaldoTexto}"
                            TextColor="#0f172A" />

                    </VerticalStackLayout>

                </Border>

                <!--  VISÃO FINANCEIRA  -->
                <Border
                    Padding="16"
                    BackgroundColor="White"
                    Stroke="#CCCDC6"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="1">

                    <VerticalStackLayout Spacing="14">

                        <!--  VISÃO FINANCEIRA  -->
                        <Label
                            Margin="4,0,0,-10"
                            FontFamily="PoppinsSemiBold"
                            FontSize="18"
                            Text="Visão financeira"
                            TextColor="#0F172A" />

                        <!--  LEGENDA  -->
                        <FlexLayout
                            AlignItems="Center"
                            JustifyContent="Start"
                            Wrap="Wrap">

                            <!--  Receitas  -->
                            <HorizontalStackLayout Margin="0,4,7,4" Spacing="4">
                                <Ellipse
                                    Fill="#10B981"
                                    HeightRequest="11"
                                    VerticalOptions="Center"
                                    WidthRequest="11" />
                                <Label
                                    FontFamily="PoppinsMedium"
                                    FontSize="13"
                                    Text="Receitas"
                                    TextColor="#0F172A"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!--  Despesas Gerais  -->
                            <HorizontalStackLayout Margin="0,4,7,4" Spacing="4">
                                <Ellipse
                                    Fill="#EF4444"
                                    HeightRequest="11"
                                    VerticalOptions="Center"
                                    WidthRequest="11" />
                                <Label
                                    FontFamily="PoppinsMedium"
                                    FontSize="13"
                                    Text="Despesas Gerais"
                                    TextColor="#0F172A"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!--  Combustível  -->
                            <HorizontalStackLayout Margin="0,4,0,4" Spacing="4">
                                <Ellipse
                                    Fill="#F59E0B"
                                    HeightRequest="11"
                                    VerticalOptions="Center"
                                    WidthRequest="11" />
                                <Label
                                    FontFamily="PoppinsMedium"
                                    FontSize="13"
                                    Text="Combustível"
                                    TextColor="#0F172A"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                        </FlexLayout>

                        <!--  ÁREA DO GRÁFICO  -->
                        <Border
                            Padding="6"
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1">

                            <lvc:CartesianChart
                                x:Name="GraficoFinanceiro"
                                BackgroundColor="#F8FAFC"
                                HeightRequest="250"
                                HorizontalOptions="Fill"
                                MinimumHeightRequest="240"
                                Series="{Binding Series}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}" />

                        </Border>

                    </VerticalStackLayout>

                </Border>

                <!--  RESUMO FINANCEIRO  -->
                <Border
                    Padding="18"
                    BackgroundColor="White"
                    Stroke="#CCCDC6"
                    StrokeShape="RoundRectangle 18"
                    StrokeThickness="1">

                    <VerticalStackLayout Spacing="15">

                        <!--  RESUMO FINANCEIRO  -->
                        <Label
                            FontFamily="PoppinsSemiBold"
                            FontSize="18"
                            Text="Resumo Financeiro"
                            TextColor="#0F172A" />


                        <!--  RECEITAS  -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Ellipse
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Fill="#10B981"
                                HeightRequest="12"
                                VerticalOptions="Center"
                                WidthRequest="12" />

                            <Label
                                Grid.Column="1"
                                FontFamily="PoppinsMedium"
                                FontSize="15"
                                Text="Receitas"
                                TextColor="#0F172A"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="{Binding ReceitasTexto}"
                                TextColor="#10B981"
                                VerticalOptions="Center" />

                        </Grid>

                        <!--  Linha  -->
                        <BoxView
                            BackgroundColor="#E2E8F0"
                            HeightRequest="1"
                            HorizontalOptions="Fill" />


                        <!--  DESPESAS GERAIS  -->
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <Ellipse
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Fill="#EF4444"
                                HeightRequest="12"
                                VerticalOptions="Center"
                                WidthRequest="12" />

                            <Label
                                Grid.Column="1"
                                FontFamily="PoppinsMedium"
                                FontSize="15"
                                Text="Despesas Gerais"
                                TextColor="#0F172A"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="{Binding DespesasTexto}"
                                TextColor="#EF4444"
                                VerticalOptions="Center" />

                        </Grid>

                        <!--  Linha  -->
                        <BoxView
                            BackgroundColor="#E2E8F0"
                            HeightRequest="1"
                            HorizontalOptions="Fill" />


                        <!--  COMBUSTÍVEL  -->
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <Ellipse
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Fill="#F59E0B"
                                HeightRequest="12"
                                VerticalOptions="Center"
                                WidthRequest="12" />

                            <Label
                                Grid.Column="1"
                                FontFamily="PoppinsMedium"
                                FontSize="15"
                                Text="Combustível"
                                TextColor="#0F172A"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="{Binding CombustivelTexto}"
                                TextColor="#F59E0B"
                                VerticalOptions="Center" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!--  TÍTULO DAS TRANSAÇÕES  -->
                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Grid.Column="0"
                        FontFamily="PoppinsSemiBold"
                        FontSize="18"
                        Text="Últimas Transações"
                        TextColor="#0F172A"
                        VerticalOptions="Center" />

                    <!--  VER TODAS  -->
                    <Label
                        Grid.Column="1"
                        FontFamily="PoppinsSemiBold"
                        FontSize="13"
                        Text="Ver todas"
                        TextColor="#2C63B1"
                        VerticalOptions="Center" />

                </Grid>

                <!--  LISTA DE TRANSAÇÕES (uma linha para cada item da ViewModel)  -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Transacoes}" Spacing="18">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TransacaoItem">

                            <Border
                                Padding="15"
                                BackgroundColor="White"
                                Stroke="#CCCDC6"
                                StrokeShape="RoundRectangle 15"
                                StrokeThickness="1">

                                <Grid ColumnDefinitions="55,*,Auto" ColumnSpacing="5">

                                    <Border
                                        Grid.Column="0"
                                        BackgroundColor="{Binding CorFundoIcone}"
                                        HeightRequest="50"
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        WidthRequest="50">

                                        <Image
                                            Aspect="AspectFit"
                                            HeightRequest="30"
                                            HorizontalOptions="Center"
                                            Source="{Binding Icone}"
                                            VerticalOptions="Center"
                                            WidthRequest="30" />

                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label
                                            FontFamily="PoppinsSemiBold"
                                            FontSize="13"
                                            Text="{Binding Titulo}"
                                            TextColor="#0F172A" />
                                        <Label
                                            FontFamily="PoppinsRegular"
                                            FontSize="12"
                                            Text="{Binding Data}"
                                            TextColor="#888888" />
                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="2"
                                        FontFamily="PoppinsBold"
                                        FontSize="13"
                                        Text="{Binding Valor}"
                                        TextColor="{Binding CorValor}"
                                        VerticalOptions="Center" />

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <!--  RODAPÉ  -->
        <Grid
            Grid.Row="2"
            Padding="20,10"
            BackgroundColor="White">

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        FontFamily="PoppinsMedium"
                        FontSize="14"
                        Text="Rota Atual: Ativa"
                        TextColor="#64748B" />

                </VerticalStackLayout>

                <!--  NOVA DESPESA (SOMENTE VISUAL: a ação será ligada quando a tela de despesa existir)  -->
                <Button
                    Grid.Column="1"
                    Padding="16,0"
                    BackgroundColor="#2C63B1"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontSize="13"
                    HeightRequest="42"
                    Text="+ NOVA DESPESA"
                    TextColor="White"
                    VerticalOptions="Center" />

            </Grid>

        </Grid>

    </Grid>

</ContentPage>
