<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="#2C63B1" />
                <GradientStop Offset="1.0" Color="#1EA1E8" />
            </LinearGradientBrush>
        </Grid.Background>

        <VerticalStackLayout
            Padding="35"
            HorizontalOptions="Center"
            Spacing="20"
            VerticalOptions="Center">

            <Image
                HeightRequest="180"
                HorizontalOptions="Center"
                Opacity="0.9"
                Source="logo_azul.png"
                WidthRequest="180" />

            <Label
                FontFamily="PoppinsSemiBold"
                FontSize="34"
                HorizontalTextAlignment="Center"
                Text="Bem-vindo!"
                TextColor="White" />

            <Label
                FontFamily="PoppinsRegular"
                FontSize="16"
                HorizontalTextAlignment="Center"
                Text="Que bom ter você aqui no INOVA."
                TextColor="White" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>