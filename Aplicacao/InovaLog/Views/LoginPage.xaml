<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="#F8F8F8"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <ScrollView>
        <Grid RowDefinitions="400,Auto">

            <!--  BLOCO AZUL (TOPO)  -->
            <BoxView Grid.Row="0">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="1.0" Color="#1EA1E8" />
                        <GradientStop Offset="0.0" Color="#2C63B1" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!--  Logo  -->
            <Image
                Grid.Row="0"
                Margin="-30,0,0,50"
                HeightRequest="400"
                HorizontalOptions="Start"
                Opacity="0.40"
                Source="logo_azul.png"
                VerticalOptions="Center"
                WidthRequest="350" />

            <!--  Onda branca  -->
            <Path
                Grid.Row="0"
                Aspect="Fill"
                Data="M0,55 C120,15 210,80 320,55 C360,45 390,48 400,50 L400,100 L0,100 Z"
                Fill="#F8F8F8"
                HeightRequest="90"
                HorizontalOptions="Fill"
                VerticalOptions="End" />

            <!--  FORMULÁRIO  -->
            <VerticalStackLayout
                Grid.Row="1"
                Margin="0,-20,0,0"
                Padding="35,0,35,35"
                BackgroundColor="#F8F8F8"
                Spacing="10">

                <!--  Título  -->
                <Label
                    FontAttributes="Bold"
                    FontFamily="PoppinsMedium"
                    FontSize="40"
                    Text="Login"
                    TextColor="#E66D17" />


                <!--  Usuário  -->
                <Border
                    Padding="14,4"
                    BackgroundColor="White"
                    Stroke="#D4D4D4"
                    StrokeShape="RoundRectangle 34"
                    StrokeThickness="1.2">

                    <Entry
                        Placeholder="Usuário / E-mail"
                        Text="{Binding Email}"
                        FontFamily="PoppinsRegular"
                        PlaceholderColor="#A6A1A1"
                        TextColor="Black" 
                        BackgroundColor="Transparent" />

                </Border>

                <!--  Senha  -->
                <Border
                    Padding="14,4"
                    BackgroundColor="White"
                    Stroke="#D4D4D4"
                    StrokeShape="RoundRectangle 34"
                    StrokeThickness="1.2">


                    <Entry
                        Placeholder="Senha"
                        Text="{Binding Senha}"
                        PlaceholderColor="#A6A1A1"
                        TextColor="Black"
                        FontFamily="PoppinsRegular"
                        IsPassword="True"
                        BackgroundColor="Transparent" />

                </Border>

                <!--  Esqueci senha + lembrar  -->
                <Grid ColumnDefinitions="*">

                    <Button
                        Grid.Column="0"
                        Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Command="{Binding IrParaEsqueciSenhaCommand}"
                        FontFamily="PoppinsRegular"
                        FontSize="14"
                        HorizontalOptions="Start"
                        Text="Esqueceu a senha?"
                        TextColor="Black"
                        VerticalOptions="Center" />

                </Grid>

                <!--  Linha  -->
                <BoxView
                    Margin="0,8"
                    BackgroundColor="#D4D4D4"
                    HeightRequest="1"
                    WidthRequest="291.04" />

                <!--  Botões  -->
                <Grid
                    Margin="0,10"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="20">

                    <Button
                        Text="Entrar"
                        BackgroundColor="#E66D17"
                        TextColor="White"
                        CornerRadius="22"
                        HeightRequest="46"
                        Grid.Column="0"
                        FontFamily="PoppinsSemiBold"
                        FontSize="16"
                        Command="{Binding EntrarCommand}" />

                    <Button
                        Grid.Column="1"
                        BackgroundColor="White"
                        BorderColor="#DDDDDD"
                        BorderWidth="1"
                        CornerRadius="22"
                        FontFamily="PoppinsSemiBold"
                        FontSize="16"
                        HeightRequest="46"
                        ImageSource="icon_google.png"
                        Text="Google"
                        TextColor="#565050" />

                </Grid>

                <!--  Rodapé  -->
                <Button
                    Padding="0"
                    BackgroundColor="Transparent"
                    Command="{Binding IrParaInformacoesCommand}"
                    FontFamily="PoppinsRegular"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Informações sobre login"
                    TextColor="Black" />

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>