<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.GastoEstradaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Gasto de Estrada"
    BackgroundColor="#F8F8F8"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid>

        <!--  ======================================  -->
        <!--  TELA PRINCIPAL  -->
        <!--  ======================================  -->
        <Grid RowDefinitions="Auto,*,1,Auto" RowSpacing="0">

            <!--  CABEÇALHO  -->
            <Grid
                Grid.Row="0"
                Padding="20,8,15,8"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="6"
                HeightRequest="85">

                <Grid.Background>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#2C63B1" />
                        <GradientStop Offset="1.0" Color="#1EA1E8" />
                    </LinearGradientBrush>
                </Grid.Background>

                <!--  BOTÃO HAMBÚRGUER  -->
                <Grid
                    x:Name="BtnMenuHamburguer"
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    HeightRequest="44"
                    VerticalOptions="Center"
                    WidthRequest="44">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuClicked" />
                    </Grid.GestureRecognizers>

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="5"
                        VerticalOptions="Center">

                        <BoxView
                            BackgroundColor="White"
                            CornerRadius="2"
                            HeightRequest="3"
                            WidthRequest="24" />
                        <BoxView
                            BackgroundColor="White"
                            CornerRadius="2"
                            HeightRequest="3"
                            WidthRequest="24" />
                        <BoxView
                            BackgroundColor="White"
                            CornerRadius="2"
                            HeightRequest="3"
                            WidthRequest="24" />
                    </VerticalStackLayout>
                </Grid>

                <!--  TÍTULO  -->
                <Label
                    Grid.Column="1"
                    FontFamily="PoppinsSemiBold"
                    FontSize="22"
                    Text="Gasto de Estrada"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>

            <!--  FORMULÁRIO  -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20,20,20,25" Spacing="0">

                    <!--  DESCRIÇÃO  -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Ellipse
                            Fill="#E66D17"
                            HeightRequest="11"
                            VerticalOptions="Center"
                            WidthRequest="11" />
                        <Label
                            Grid.Column="1"
                            FontFamily="PoppinsSemiBold"
                            FontSize="15"
                            Text="Descrição"
                            TextColor="#0F172A"
                            VerticalOptions="Center" />
                    </Grid>

                    <Border
                        Margin="0,5,0,22"
                        Padding="12,0"
                        BackgroundColor="White"
                        Stroke="#D1D5DB"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="1">

                        <Entry
                            x:Name="TxtDescricao"
                            BackgroundColor="Transparent"
                            ClearButtonVisibility="WhileEditing"
                            FontFamily="PoppinsRegular"
                            FontSize="14"
                            Placeholder="Ex: Abastecimento Diesel S10"
                            PlaceholderColor="#94A3B8"
                            TextColor="#334155" />
                    </Border>

                    <!--  VALOR TOTAL  -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Ellipse
                            Fill="#E66D17"
                            HeightRequest="11"
                            VerticalOptions="Center"
                            WidthRequest="11" />
                        <Label
                            Grid.Column="1"
                            FontFamily="PoppinsSemiBold"
                            FontSize="15"
                            Text="Valor Total (R$)"
                            TextColor="#0F172A"
                            VerticalOptions="Center" />
                    </Grid>

                    <Border
                        Margin="0,5,0,22"
                        Padding="12,0"
                        BackgroundColor="White"
                        Stroke="#D1D5DB"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="1">

                        <Entry
                            x:Name="TxtValor"
                            BackgroundColor="Transparent"
                            FontFamily="PoppinsRegular"
                            FontSize="14"
                            Keyboard="Numeric"
                            Placeholder="R$ 0,00"
                            PlaceholderColor="#94A3B8"
                            TextColor="#334155" />
                    </Border>

                    <!--  CONTROLE DE COMBUSTÍVEL  -->
                    <Border
                        Margin="0,0,0,22"
                        Padding="14"
                        BackgroundColor="#EFF6FF"
                        Stroke="#BFDBFE"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="1">

                        <VerticalStackLayout Spacing="12">

                            <Label
                                FontFamily="PoppinsSemiBold"
                                FontSize="13"
                                Text="Controle de Combustível (Cálculo Automático do Litro)"
                                TextColor="#1D61D2" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                <!--  QUANTIDADE DE LITROS  -->
                                <VerticalStackLayout Grid.Column="0" Spacing="5">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Ellipse
                                            Fill="#E66D17"
                                            HeightRequest="11"
                                            VerticalOptions="Center"
                                            WidthRequest="11" />
                                        <Label
                                            Grid.Column="1"
                                            FontFamily="PoppinsSemiBold"
                                            FontSize="13"
                                            Text="Qtd. de Litros"
                                            TextColor="#0F172A"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <Border
                                        Padding="12,0"
                                        BackgroundColor="White"
                                        Stroke="#D1D5DB"
                                        StrokeShape="RoundRectangle 22"
                                        StrokeThickness="1">

                                        <Entry
                                            x:Name="TxtLitros"
                                            BackgroundColor="Transparent"
                                            FontFamily="PoppinsRegular"
                                            FontSize="14"
                                            Keyboard="Numeric"
                                            Placeholder="0"
                                            PlaceholderColor="#94A3B8"
                                            TextColor="#334155" />
                                    </Border>
                                </VerticalStackLayout>

                                <!--  PREÇO POR LITRO  -->
                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Ellipse
                                            Fill="#10B981"
                                            HeightRequest="11"
                                            VerticalOptions="Center"
                                            WidthRequest="11" />
                                        <Label
                                            Grid.Column="1"
                                            FontFamily="PoppinsSemiBold"
                                            FontSize="13"
                                            Text="Preço / Litro"
                                            TextColor="#0F172A"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <Border
                                        Padding="12,0"
                                        BackgroundColor="#DBEAFE"
                                        HeightRequest="48"
                                        Stroke="#BFDBFE"
                                        StrokeShape="RoundRectangle 22"
                                        StrokeThickness="1">

                                        <Label
                                            x:Name="LblPrecoLitro"
                                            FontFamily="PoppinsSemiBold"
                                            FontSize="14"
                                            Text="R$ 0,00 / L"
                                            TextColor="#1D61D2"
                                            VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!--  STATUS E DATA  -->
                    <Grid
                        Margin="0,0,0,22"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <!--  STATUS  -->
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Ellipse
                                    Fill="#E66D17"
                                    HeightRequest="11"
                                    VerticalOptions="Center"
                                    WidthRequest="11" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="PoppinsSemiBold"
                                    FontSize="15"
                                    Text="Status"
                                    TextColor="#0F172A"
                                    VerticalOptions="Center" />
                            </Grid>

                            <Border
                                Padding="12,0,4,0"
                                BackgroundColor="White"
                                Stroke="#D1D5DB"
                                StrokeShape="RoundRectangle 22"
                                StrokeThickness="1">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <Picker
                                        x:Name="PckStatus"
                                        Title="Status"
                                        Grid.Column="0"
                                        FontFamily="PoppinsRegular"
                                        FontSize="14"
                                        SelectedIndex="0"
                                        TextColor="#334155"
                                        TitleColor="#94A3B8">
                                        <Picker.Items>
                                            <x:String>Pago / Recebido</x:String>
                                            <x:String>Pendente</x:String>
                                        </Picker.Items>
                                    </Picker>

                                    <ImageButton
                                        Grid.Column="1"
                                        Padding="8"
                                        Aspect="AspectFit"
                                        BackgroundColor="Transparent"
                                        HeightRequest="30"
                                        InputTransparent="True"
                                        Source="seta_para_baixo.png"
                                        VerticalOptions="Center"
                                        WidthRequest="30" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!--  DATA  -->
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Ellipse
                                    Fill="#E66D17"
                                    HeightRequest="11"
                                    VerticalOptions="Center"
                                    WidthRequest="11" />
                                    <Label
                                        Grid.Column="1"
                                    FontFamily="PoppinsSemiBold"
                                    FontSize="15"
                                    Text="Data"
                                    TextColor="#0F172A"
                                    VerticalOptions="Center" />
                            </Grid>

                            <Border
                                Padding="12,0"
                                BackgroundColor="White"
                                Stroke="#D1D5DB"
                                StrokeShape="RoundRectangle 22"
                                StrokeThickness="1">

                                <DatePicker
                                    x:Name="DpData"
                                    BackgroundColor="Transparent"
                                    FontFamily="PoppinsRegular"
                                    FontSize="14"
                                    Format="dd/MM/yyyy"
                                    TextColor="#334155" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!--  DATA DE PAGAMENTO  -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Ellipse
                            Fill="#E66D17"
                            HeightRequest="11"
                            VerticalOptions="Center"
                            WidthRequest="11" />
                        <Label
                            Grid.Column="1"
                            FontFamily="PoppinsSemiBold"
                            FontSize="15"
                            Text="Data de Pagamento/Recebimento (Exigido se Pago)"
                            TextColor="#0F172A"
                            VerticalOptions="Center" />
                    </Grid>

                    <Border
                        Margin="0,5,0,22"
                        Padding="12,0"
                        BackgroundColor="White"
                        Stroke="#D1D5DB"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="1">

                        <DatePicker
                            x:Name="DpDataPagamento"
                            BackgroundColor="Transparent"
                            FontFamily="PoppinsRegular"
                            FontSize="14"
                            Format="dd/MM/yyyy"
                            TextColor="#334155" />
                    </Border>

                    <!--  ROTA / VIAGEM ASSOCIADA  -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Ellipse
                            Fill="#E66D17"
                            HeightRequest="11"
                            VerticalOptions="Center"
                            WidthRequest="11" />
                        <Label
                            Grid.Column="1"
                            FontFamily="PoppinsSemiBold"
                            FontSize="15"
                            Text="Rota / Viagem Associada (Obrigatório p/ Combustível)"
                            TextColor="#0F172A"
                            VerticalOptions="Center" />
                    </Grid>

                    <Border
                        Margin="0,5,0,22"
                        Padding="12,0"
                        BackgroundColor="White"
                        Stroke="#D1D5DB"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="1">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                            <Picker
                                x:Name="PckRotaAssociada"
                                Title="Selecione a rota"
                                Grid.Column="0"
                                FontFamily="PoppinsRegular"
                                FontSize="14"
                                SelectedIndex="0"
                                TextColor="#334155"
                                TitleColor="#94A3B8">

                                <Picker.Items>
                                    <x:String>-- Sem vínculo de viagem (Custo Fixo) --</x:String>
                                    <x:String>Varginha → Três Pontas</x:String>
                                    <x:String>Varginha → São Paulo</x:String>
                                    <x:String>Varginha → Belo Horizonte</x:String>
                                    <x:String>Outra rota</x:String>
                                </Picker.Items>
                            </Picker>

                            <ImageButton
                                Grid.Column="1"
                                Padding="8"
                                Aspect="AspectFit"
                                BackgroundColor="Transparent"
                                HeightRequest="30"
                                InputTransparent="True"
                                Source="seta_para_baixo.png"
                                VerticalOptions="Center"
                                WidthRequest="30" />
                        </Grid>
                    </Border>

                    <!--  FORMA DE PAGAMENTO  -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Ellipse
                            Fill="#E66D17"
                            HeightRequest="11"
                            VerticalOptions="Center"
                            WidthRequest="11" />
                        <Label
                            Grid.Column="1"
                            FontFamily="PoppinsSemiBold"
                            FontSize="15"
                            Text="Forma de Pagamento"
                            TextColor="#0F172A"
                            VerticalOptions="Center" />
                    </Grid>

                    <Border
                        Margin="0,5,0,22"
                        Padding="12,0"
                        BackgroundColor="White"
                        Stroke="#D1D5DB"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="1">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                            <Picker
                                x:Name="PckFormaPagamento"
                                Title="Selecione a forma de pagamento"
                                Grid.Column="0"
                                FontFamily="PoppinsRegular"
                                FontSize="14"
                                TextColor="#334155"
                                TitleColor="#94A3B8">

                                <Picker.Items>
                                    <x:String>Cartão Frota</x:String>
                                    <x:String>Cartão Corporativo</x:String>
                                    <x:String>Dinheiro</x:String>
                                    <x:String>PIX</x:String>
                                    <x:String>Outro</x:String>
                                </Picker.Items>
                            </Picker>

                            <ImageButton
                                Grid.Column="1"
                                Padding="8"
                                Aspect="AspectFit"
                                BackgroundColor="Transparent"
                                HeightRequest="30"
                                InputTransparent="True"
                                Source="seta_para_baixo.png"
                                VerticalOptions="Center"
                                WidthRequest="30" />
                        </Grid>
                    </Border>

                    <!--  FOTO DO COMPROVANTE  -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Ellipse
                            Fill="#E66D17"
                            HeightRequest="11"
                            VerticalOptions="Center"
                            WidthRequest="11" />
                        <Label
                            Grid.Column="1"
                            FontFamily="PoppinsSemiBold"
                            FontSize="15"
                            Text="Foto do Comprovante / &quot;Notinha&quot; (Câmera ou Galeria)"
                            TextColor="#0F172A"
                            VerticalOptions="Center" />
                    </Grid>

                    <Border
                        Margin="0,5,0,8"
                        Padding="12,8"
                        BackgroundColor="White"
                        Stroke="#D1D5DB"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="1">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Button
                                x:Name="BtnEscolherArquivo"
                                Grid.Column="0"
                                Padding="14,0"
                                BackgroundColor="#F1F5F9"
                                BorderColor="#CBD5E1"
                                BorderWidth="1"
                                CornerRadius="10"
                                FontFamily="PoppinsRegular"
                                FontSize="12"
                                HeightRequest="38"
                                Text="Escolher arquivo"
                                TextColor="#334155"
                                VerticalOptions="Center" />

                            <Label
                                x:Name="LblArquivo"
                                Grid.Column="1"
                                FontFamily="PoppinsRegular"
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                Text="Nenhum arquivo escolhido"
                                TextColor="#64748B"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label
                        Margin="0,0,0,22"
                        FontAttributes="Italic"
                        FontFamily="PoppinsRegular"
                        FontSize="12"
                        Text="Obrigatório para despesas de estrada. Guardado localmente se estiver sem internet."
                        TextColor="#94A3B8" />

                    <!--  CAMPOS OBRIGATÓRIOS  -->
                    <HorizontalStackLayout Spacing="6">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="*"
                            TextColor="#DC2626"
                            VerticalOptions="Center" />

                        <Label
                            FontFamily="PoppinsRegular"
                            FontSize="12"
                            Text="Todos os campos são obrigatórios."
                            TextColor="#64748B"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <BoxView Grid.Row="2" Color="#E2E8F0" />

            <!--  RODAPÉ FIXO  -->
            <Grid
                Grid.Row="3"
                Padding="16,10"
                BackgroundColor="White">

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">

                    <!--  CANCELAR  -->
                    <Button
                        Padding="54,0"
                        BackgroundColor="White"
                        BorderColor="#D1D5DB"
                        BorderWidth="1"
                        Clicked="OnCancelarClicked"
                        CornerRadius="9"
                        FontSize="12"
                        HeightRequest="42"
                        Text="CANCELAR"
                        TextColor="#334155" />

                    <!--  SALVAR  -->
                    <Button
                        Padding="54,0"
                        BackgroundColor="#2C63B1"
                        CornerRadius="9"
                        FontFamily="PoppinsSemiBold"
                        FontSize="12"
                        HeightRequest="42"
                        Text="SALVAR"
                        TextColor="White" />

                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <!--  ======================================  -->
        <!--  MENU LATERAL (por cima da tela)  -->
        <!--  ======================================  -->
        <Grid x:Name="OverlayMenu" IsVisible="False">

            <!--  FUNDO ESCURO (toque fecha o menu)  -->
            <BoxView
                x:Name="FundoMenu"
                BackgroundColor="Black"
                Opacity="0">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFecharMenuTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!--  PAINEL  -->
            <Grid
                x:Name="PainelMenu"
                BackgroundColor="White"
                HorizontalOptions="Start"
                RowDefinitions="Auto,*"
                RowSpacing="0"
                WidthRequest="280">

                <!--  TOPO DO MENU  -->
                <Grid
                    Grid.Row="0"
                    Padding="20,8,15,8"
                    ColumnDefinitions="*,Auto"
                    HeightRequest="85">

                    <Grid.Background>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#2C63B1" />
                            <GradientStop Offset="1.0" Color="#1EA1E8" />
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Label
                        FontFamily="PoppinsSemiBold"
                        FontSize="20"
                        Text="Menu"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        FontFamily="PoppinsSemiBold"
                        FontSize="22"
                        Text="✕"
                        TextColor="White"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFecharMenuTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!--  ITENS  -->
                <VerticalStackLayout
                    Grid.Row="1"
                    Padding="12,16"
                    Spacing="6">

                    <!--  MINHAS VIAGENS  -->
                    <Border
                        Padding="14,12"
                        BackgroundColor="Transparent"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuMinhasViagensTapped" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="14">
                            <Image
                                HeightRequest="22"
                                Source="icone_viagens.png"
                                VerticalOptions="Center"
                                WidthRequest="22">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="#64748B" />
                                </Image.Behaviors>
                            </Image>

                            <Label
                                FontFamily="PoppinsRegular"
                                FontSize="15"
                                Text="Minhas Viagens"
                                TextColor="#334155"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!--  GASTO DE ESTRADA (ativo)  -->
                    <Border
                        Padding="14,12"
                        BackgroundColor="#EAF2FF"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuGastoEstradaTapped" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="14">
                            <Image
                                HeightRequest="22"
                                Source="icone_gasto.svg"
                                VerticalOptions="Center"
                                WidthRequest="22">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="#1D61D2" />
                                </Image.Behaviors>
                            </Image>

                            <Label
                                FontFamily="PoppinsSemiBold"
                                FontSize="15"
                                Text="Gasto de Estrada"
                                TextColor="#1D61D2"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!--  NOVA VIAGEM  -->
                    <Border
                        Padding="14,12"
                        BackgroundColor="Transparent"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuNovaViagemTapped" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="14">
                            <Image
                                HeightRequest="22"
                                Source="icone_nova_viagem.png"
                                VerticalOptions="Center"
                                WidthRequest="22">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="#64748B" />
                                </Image.Behaviors>
                            </Image>

                            <Label
                                FontFamily="PoppinsRegular"
                                FontSize="15"
                                Text="Nova Viagem"
                                TextColor="#334155"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>
        </Grid>

    </Grid>
</ContentPage>