<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.InformacoesLoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <ScrollView>

        <Grid RowDefinitions="450,Auto">

            <!--  BLOCO AZUL (TOPO)  -->
            <BoxView Grid.Row="0">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="1.0" Color="#1EA1E8" />
                        <GradientStop Offset="0.0" Color="#2C63B1" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!--  Logo  -->
            <Image
                Grid.Row="0"
                Margin="-30,0,0,50"
                HeightRequest="400"
                HorizontalOptions="Start"
                Opacity="0.40"
                Source="logo_azul.png"
                VerticalOptions="Center"
                WidthRequest="400" />

            <!--  Onda branca  -->
            <Path
                Grid.Row="0"
                Aspect="Fill"
                Data="M0,55 C120,15 210,80 320,55 C360,45 390,48 400,50 L400,100 L0,100 Z"
                Fill="#F8F8F8"
                HeightRequest="90"
                HorizontalOptions="Fill"
                VerticalOptions="End" />

            <!--  BLOCO BRANCO  -->
            <VerticalStackLayout
                Grid.Row="1"
                Margin="0,-2,0,0"
                Padding="35,0,35,35"
                BackgroundColor="#F8F8F8"
                Spacing="18">

                <!--  Título  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="34"
                    Text="Informações de Login"
                    TextColor="#E66D17" />

                <!--  Texto principal  -->
                <Label
                    FontSize="16"
                    LineBreakMode="WordWrap"
                    Text="O acesso ao aplicativo INOVA é fornecido exclusivamente pela empresa. Cada colaborador recebe um usuário e uma senha individuais para utilizar o sistema."
                    TextColor="#444444" />

                <!--  Caixa de informações  -->
                <Border
                    Padding="18"
                    BackgroundColor="#F8F8F8"
                    Stroke="#D9D9D9"
                    StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Como acessar o sistema?"
                            TextColor="#2C63B1" />

                        <Label
                            FontSize="15"
                            Text="• Utilize o usuário ou e-mail informado pela empresa."
                            TextColor="#444444" />

                        <Label
                            FontSize="15"
                            Text="• Digite a senha fornecida pelo administrador do sistema."
                            TextColor="#444444" />

                        <Label
                            FontSize="15"
                            Text="• Não compartilhe seu login ou senha com outras pessoas."
                            TextColor="#444444" />

                        <Label
                            FontSize="15"
                            Text="• Caso esqueça sua senha, utilize a opção 'Esqueci a senha'."
                            TextColor="#444444" />

                    </VerticalStackLayout>

                </Border>

                <!--  Aviso  -->
                <Border
                    Padding="18"
                    BackgroundColor="#FFF5EC"
                    Stroke="#F58220"
                    StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Importante"
                            TextColor="#F58220" />

                        <Label
                            FontSize="14"
                            LineBreakMode="WordWrap"
                            Text="Somente o setor responsável ou o administrador do sistema pode criar usuários e redefinir senhas."
                            TextColor="#555555" />

                    </VerticalStackLayout>

                </Border>

                <!--  Botão  -->
                <Button
                    Margin="0,15,0,0"
                    BackgroundColor="#F58220"
                    Command="{Binding VoltarLoginCommand}"
                    CornerRadius="22"
                    FontAttributes="Bold"
                    HeightRequest="46"
                    Text="Voltar para o Login"
                    TextColor="White" />

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>