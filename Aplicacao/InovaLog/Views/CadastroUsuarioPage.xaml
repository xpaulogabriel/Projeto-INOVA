<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.CadastroUsuarioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="{Binding TituloPagina}"
    BackgroundColor="#F8F8F8">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!--  CABEÇALHO AZUL  -->
        <Grid
            Grid.Row="0"
            Padding="30,10,15,5"
            HeightRequest="85">
            <Grid.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                    <GradientStop Offset="1.0" Color="#1EA1E8" />
                    <GradientStop Offset="0.0" Color="#2C63B1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Label
                FontSize="20"
                HorizontalOptions="Start"
                Text="{Binding TituloPagina}"
                TextColor="White"
                VerticalOptions="Center" />

            <Image
                HeightRequest="80"
                HorizontalOptions="End"
                Opacity="0.25"
                Source="logo_azul.png"
                VerticalOptions="Center"
                WidthRequest="80" />
        </Grid>

        <!--  FORMULÁRIO  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="30,20,30,20"
                IsEnabled="{Binding PodeEditar}"
                Spacing="12">

                <!--  Nome completo  -->
                <Label FontAttributes="Bold" FontSize="15" Text="Nome Completo" TextColor="Black" />
                <Border Padding="12,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                    <Entry FontSize="12" HeightRequest="38" Placeholder="Nome" PlaceholderColor="#A0A0A0" Text="{Binding Nome}" TextColor="Black" />
                </Border>

                <!--  Perfil de acesso  -->
                <Label FontAttributes="Bold" FontSize="15" Text="Perfil de Acesso" TextColor="Black" />
                <Border Padding="8,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                    <Picker
                        Title="Selecione o perfil"
                        FontSize="12"
                        HeightRequest="38"
                        ItemDisplayBinding="{Binding Nome}"
                        ItemsSource="{Binding Perfis}"
                        SelectedItem="{Binding PerfilSelecionado}"
                        TextColor="Black" />
                </Border>

                <!--  E-mail  -->
                <Label FontAttributes="Bold" FontSize="15" Text="E-mail Google de Acesso" TextColor="Black" />
                <Border Padding="12,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                    <Entry
                        FontSize="12"
                        HeightRequest="38"
                        IsEnabled="{Binding EhCriacao}"
                        Keyboard="Email"
                        Placeholder="E-mail"
                        PlaceholderColor="#A0A0A0"
                        Text="{Binding Email}"
                        TextColor="Black" />
                </Border>
                <Label Margin="5,-6,0,0" FontAttributes="Italic" FontSize="10" Text="Informe o mesmo contato Google que o usuário usará para logar no sistema" TextColor="#555555" />

                <!--  Senha de Acesso (apenas na criação)  -->
                <VerticalStackLayout IsVisible="{Binding EhCriacao}" Spacing="6">
                    <Label FontAttributes="Bold" FontSize="15" Text="Senha de Acesso" TextColor="Black" />
                    <Border Padding="12,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                        <Entry
                            FontSize="12"
                            HeightRequest="38"
                            IsPassword="True"
                            Placeholder="Mínimo 6 caracteres"
                            PlaceholderColor="#A0A0A0"
                            Text="{Binding Senha}"
                            TextColor="Black" />
                    </Border>
                </VerticalStackLayout>

                <!--  CPF / CNPJ  -->
                <Label FontAttributes="Bold" FontSize="14" Text="CPF / CNPJ" TextColor="Black" />
                <Border Padding="12,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                    <Entry FontSize="12" HeightRequest="38" Keyboard="Numeric" Placeholder="000.000.000-00" PlaceholderColor="#A0A0A0" Text="{Binding CpfCnpj}" TextColor="Black" />
                </Border>

                <!--  Telefone + Data de Nascimento  -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label FontAttributes="Bold" FontSize="14" Text="Telefone" TextColor="Black" />
                        <Border Padding="12,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                            <Entry FontSize="12" HeightRequest="38" Keyboard="Telephone" Placeholder="(00) 00000-0000" PlaceholderColor="#A0A0A0" Text="{Binding Telefone}" TextColor="Black" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label FontAttributes="Bold" FontSize="14" Text="Nascimento" TextColor="Black" />
                        <Border Padding="10,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                            <DatePicker Date="{Binding DataNascimento}" FontSize="12" Format="dd/MM/yyyy" HeightRequest="38" TextColor="Black" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!--  DADOS DO MOTORISTA (visível apenas quando Perfil = Motorista)  -->
                <Border
                    Margin="0,12,0,0"
                    Padding="12"
                    BackgroundColor="#F8F8F8"
                    IsVisible="{Binding EhMotorista}"
                    Stroke="#C8C8C8"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">

                    <VerticalStackLayout Spacing="10">
                        <Label FontAttributes="Bold" FontSize="14" Text="Dados do Motorista" TextColor="#2C63B1" />

                        <!--  CNH  -->
                        <Label FontAttributes="Bold" FontSize="13" Text="Nº da CNH" TextColor="Black" />
                        <Border Padding="12,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                            <Entry FontSize="12" HeightRequest="35" Keyboard="Numeric" Placeholder="12345678900" PlaceholderColor="#A0A0A0" Text="{Binding CnhNumero}" TextColor="Black" />
                        </Border>

                        <!--  Validade + Categoria  -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label FontAttributes="Bold" FontSize="13" Text="Validade CNH" TextColor="Black" />
                                <Border Padding="10,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                                    <DatePicker Date="{Binding CnhValidade}" FontSize="12" Format="dd/MM/yyyy" HeightRequest="35" TextColor="Black" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label FontAttributes="Bold" FontSize="13" Text="Categoria" TextColor="Black" />
                                <Border Padding="8,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                                    <Picker Title="D/E" FontSize="12" HeightRequest="35" SelectedItem="{Binding CnhCategoria}" TextColor="Black">
                                        <Picker.Items>
                                            <x:String>B</x:String>
                                            <x:String>C</x:String>
                                            <x:String>D</x:String>
                                            <x:String>E</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!--  EAR  -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Switch IsToggled="{Binding Ear}" Scale="0.80" VerticalOptions="Center" />
                            <Label FontSize="12" Text="Exerce Atividade Remunerada (EAR)" TextColor="Black" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator Color="#2C63B1" IsRunning="{Binding EstaSalvando}" IsVisible="{Binding EstaSalvando}" />

            </VerticalStackLayout>
        </ScrollView>

        <!--  RODAPÉ  -->
        <Grid
            Grid.Row="2"
            Margin="5,0"
            Padding="10,5"
            BackgroundColor="White"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8"
            HeightRequest="60">

            <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                <Switch
                    IsEnabled="{Binding PodeEditar}"
                    IsToggled="{Binding Ativo}"
                    Scale="0.80"
                    VerticalOptions="Center" />
                <Label FontAttributes="Bold" FontSize="12" Text="{Binding TextoStatus}" TextColor="Black" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button
                Grid.Column="1"
                Padding="12,0"
                BackgroundColor="White"
                BorderColor="#BDBDBD"
                BorderWidth="1"
                Command="{Binding CancelarCommand}"
                CornerRadius="6"
                FontSize="12"
                HeightRequest="34"
                Text="{Binding TextoBotaoCancelar}"
                TextColor="#333333" />

            <Button
                Grid.Column="2"
                Padding="14,0"
                BackgroundColor="#2C63B1"
                Command="{Binding CadastrarCommand}"
                CornerRadius="6"
                FontSize="12"
                HeightRequest="34"
                IsEnabled="{Binding PodeSalvar}"
                IsVisible="{Binding MostrarBotaoSalvar}"
                Text="{Binding TextoBotaoSalvar}"
                TextColor="White" />
        </Grid>

    </Grid>
</ContentPage>