<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.NovaDespesaPag"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="NovaDespesaPag"
    BackgroundColor="#F8F8F8"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!--  CABEÇALHO  -->
        <Grid
            Grid.Row="0"
            Padding="20,10,15,5"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="5"
            HeightRequest="85">

            <Grid.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="#2C63B1" />
                    <GradientStop Offset="1.0" Color="#1EA1E8" />
                </LinearGradientBrush>
            </Grid.Background>

            <ImageButton
                Grid.Column="0"
                Padding="8"
                Aspect="AspectFit"
                BackgroundColor="Transparent"
                Source="btn_voltar.svg"
                VerticalOptions="Center"
                WidthRequest="55" />

            <Label
                Grid.Column="1"
                FontFamily="PoppinsSemiBold"
                FontSize="25"
                HorizontalOptions="Start"
                Text="Nova Despesa"
                TextColor="White"
                VerticalOptions="Center" />

            <Image
                Grid.Column="2"
                HeightRequest="70"
                HorizontalOptions="End"
                Source="logo_azul.png"
                VerticalOptions="Center"
                WidthRequest="70" />
        </Grid>

        <!--  FORMULÁRIO  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,25" Spacing="0">

                <!--  TIPO DE DESPESA  -->
                <HorizontalStackLayout Spacing="8">
                    <Ellipse
                        Fill="#E66D17"
                        HeightRequest="11"
                        VerticalOptions="Center"
                        WidthRequest="11" />

                    <Label
                        FontFamily="PoppinsSemiBold"
                        FontSize="15"
                        Text="Tipo de Despesa"
                        TextColor="#0F172A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Margin="0,5,0,25"
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#CCCDC6"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="1">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <Picker
                            x:Name="PckTipoDespesa"
                            Title="Selecione o tipo"
                            Grid.Column="0"
                            FontFamily="PoppinsRegular"
                            FontSize="14"
                            TextColor="#334155"
                            TitleColor="#94A3B8">

                            <Picker.Items>
                                <x:String>Combustível</x:String>
                                <x:String>Pedágio</x:String>
                                <x:String>Manutenção</x:String>
                                <x:String>Alimentação</x:String>
                                <x:String>Hospedagem</x:String>
                                <x:String>Outros</x:String>
                            </Picker.Items>
                        </Picker>

                        <ImageButton
                            Grid.Column="1"
                            Padding="8"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            HeightRequest="30"
                            Source="seta_para_baixo.png"
                            VerticalOptions="Center"
                            WidthRequest="30" />
                    </Grid>
                </Border>

                <!--  DESCRIÇÃO  -->
                <HorizontalStackLayout Spacing="8">
                    <Ellipse
                        Fill="#E66D17"
                        HeightRequest="11"
                        VerticalOptions="Center"
                        WidthRequest="11" />

                    <Label
                        FontFamily="PoppinsSemiBold"
                        FontSize="15"
                        Text="Descrição"
                        TextColor="#0F172A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Margin="0,5,0,25"
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D1D5DB"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="1">

                    <Entry
                        x:Name="TxtDescricao"
                        BackgroundColor="Transparent"
                        ClearButtonVisibility="WhileEditing"
                        FontFamily="PoppinsRegular"
                        FontSize="14"
                        Placeholder="Digite a descrição"
                        PlaceholderColor="#94A3B8"
                        TextColor="#334155" />
                </Border>

                <!--  VALOR  -->
                <HorizontalStackLayout Spacing="8">
                    <Ellipse
                        Fill="#E66D17"
                        HeightRequest="11"
                        VerticalOptions="Center"
                        WidthRequest="11" />

                    <Label
                        FontFamily="PoppinsSemiBold"
                        FontSize="15"
                        Text="Valor"
                        TextColor="#0F172A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Margin="0,5,0,25"
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D1D5DB"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="1">

                    <Entry
                        x:Name="TxtValor"
                        BackgroundColor="Transparent"
                        FontFamily="PoppinsRegular"
                        FontSize="14"
                        Keyboard="Numeric"
                        Placeholder="R$ 0,00"
                        PlaceholderColor="#94A3B8"
                        TextColor="#334155" />
                </Border>

                <!--  DATA  -->
                <HorizontalStackLayout Spacing="8">
                    <Ellipse
                        Fill="#E66D17"
                        HeightRequest="11"
                        VerticalOptions="Center"
                        WidthRequest="11" />

                    <Label
                        FontFamily="PoppinsSemiBold"
                        FontSize="15"
                        Text="Data"
                        TextColor="#0F172A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Margin="0,5,0,25"
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D1D5DB"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="1">

                    <DatePicker
                        x:Name="DpData"
                        BackgroundColor="Transparent"
                        FontFamily="PoppinsRegular"
                        FontSize="14"
                        Format="dd/MM/yyyy"
                        TextColor="#334155" />
                </Border>

                <!--  ROTA ASSOCIADA  -->
                <HorizontalStackLayout Spacing="8">
                    <Ellipse
                        Fill="#E66D17"
                        HeightRequest="11"
                        VerticalOptions="Center"
                        WidthRequest="11" />

                    <Label
                        FontFamily="PoppinsSemiBold"
                        FontSize="15"
                        Text="Rota Associada"
                        TextColor="#0F172A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Margin="0,5,0,25"
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D1D5DB"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="1">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <Picker
                            x:Name="PckRotaAssociada"
                            Title="Selecione a rota"
                            Grid.Column="0"
                            FontFamily="PoppinsRegular"
                            FontSize="13"
                            TextColor="#334155"
                            TitleColor="#94A3B8">

                            <Picker.Items>
                                <x:String>Varginha → Três Pontas</x:String>
                                <x:String>Varginha → São Paulo</x:String>
                                <x:String>Varginha → Belo Horizonte</x:String>
                                <x:String>Outra rota</x:String>
                            </Picker.Items>
                        </Picker>

                        <ImageButton
                            Grid.Column="1"
                            Padding="8"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            HeightRequest="30"
                            Source="seta_para_baixo.png"
                            VerticalOptions="Center"
                            WidthRequest="30" />
                    </Grid>
                </Border>

                <!--  FORMA DE PAGAMENTO  -->
                <HorizontalStackLayout Spacing="8">
                    <Ellipse
                        Fill="#E66D17"
                        HeightRequest="11"
                        VerticalOptions="Center"
                        WidthRequest="11" />

                    <Label
                        FontFamily="PoppinsSemiBold"
                        FontSize="15"
                        Text="Forma de Pagamento"
                        TextColor="#0F172A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Margin="0,5,0,10"
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D1D5DB"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="1">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <Picker
                            x:Name="PckFormaPagamento"
                            Title="Selecione a forma de pagamento"
                            Grid.Column="0"
                            FontFamily="PoppinsRegular"
                            FontSize="13"
                            TextColor="#334155"
                            TitleColor="#94A3B8">

                            <Picker.Items>
                                <x:String>Cartão Frota</x:String>
                                <x:String>Cartão Corporativo</x:String>
                                <x:String>Dinheiro</x:String>
                                <x:String>PIX</x:String>
                                <x:String>Outro</x:String>
                            </Picker.Items>
                        </Picker>

                        <ImageButton
                            Grid.Column="1"
                            Padding="8"
                            Aspect="AspectFit"
                            BackgroundColor="Transparent"
                            HeightRequest="30"
                            Source="seta_para_baixo.png"
                            VerticalOptions="Center"
                            WidthRequest="30" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!--  RODAPÉ FIXO  -->
        <Grid
            Grid.Row="2"
            Padding="16,10"
            BackgroundColor="White"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="6">

            <Label
                Grid.Column="0"
                FontFamily="PoppinsRegular"
                FontSize="11"
                LineBreakMode="WordWrap"
                Text="Todos os campos são obrigatórios"
                TextColor="#64748B"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Padding="12,0"
                BackgroundColor="White"
                BorderColor="#D1D5DB"
                BorderWidth="1"
                CornerRadius="9"
                FontSize="12"
                HeightRequest="42"
                Text="Cancelar"
                TextColor="#334155" />

            <Button
                Grid.Column="2"
                Padding="12,0"
                BackgroundColor="#2C63B1"
                CornerRadius="9"
                FontFamily="PoppinsSemiBold"
                FontSize="12"
                HeightRequest="42"
                Text="Salvar"
                TextColor="White" />
        </Grid>
    </Grid>
</ContentPage>