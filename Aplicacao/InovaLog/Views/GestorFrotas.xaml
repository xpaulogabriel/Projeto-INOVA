<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.GestorFrotasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:InovaLog.ViewModels"
    Title="Gestor de Frotas"
    x:DataType="vm:GestorFrotasViewModel"
    BackgroundColor="#F8F8F8"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="85,65,*" RowSpacing="0">

        <!--  CABEÇALHO  -->
        <Grid
            Grid.Row="0"
            Padding="20,8,15,8"
            ColumnDefinitions="*,Auto">

            <Grid.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#2C63B1" />
                    <GradientStop Offset="1" Color="#1EA1E8" />
                </LinearGradientBrush>
            </Grid.Background>

            <Label
                FontFamily="PoppinsSemiBold"
                FontSize="19"
                Text="Frota, Rotas &amp; Manutenção"
                TextColor="White"
                VerticalOptions="Center" />

        </Grid>

        <!--  ABAS  -->
        <Grid
            Grid.Row="1"
            Padding="10,8"
            BackgroundColor="#F8F8F8"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="6">

            <Border
                x:Name="AbaVeiculos"
                Grid.Column="0"
                Padding="3,5"
                BackgroundColor="#1675F8"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVeiculosTapped" />
                </Border.GestureRecognizers>
                <Label
                    FontFamily="PoppinsSemiBold"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Veículos"
                    TextColor="White"
                    VerticalTextAlignment="Center" />
            </Border>

            <Border
                x:Name="AbaRotas"
                Grid.Column="1"
                Padding="3,5"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRotasTapped" />
                </Border.GestureRecognizers>
                <Label
                    FontFamily="PoppinsMedium"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Rotas Padrão"
                    TextColor="#64748B"
                    VerticalTextAlignment="Center" />
            </Border>

            <Border
                x:Name="AbaPlanos"
                Grid.Column="2"
                Padding="3,5"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPlanosTapped" />
                </Border.GestureRecognizers>
                <Label
                    FontFamily="PoppinsMedium"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Revisões"
                    TextColor="#64748B"
                    VerticalTextAlignment="Center" />
            </Border>
        </Grid>

        <!--  CONTEÚDO ROLÁVEL  -->
        <ScrollView Grid.Row="2">
            <Grid Padding="16,12,16,25">

                <!--  VEÍCULOS  -->
                <VerticalStackLayout x:Name="ConteudoVeiculos" Spacing="16">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            FontFamily="PoppinsSemiBold"
                            FontSize="16"
                            Text="Caminhões Cadastrados"
                            TextColor="#475569"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="1"
                            Padding="12,5"
                            BackgroundColor="#1675F8"
                            Clicked="OnNovoVeiculoClicked"
                            CornerRadius="18"
                            FontFamily="PoppinsSemiBold"
                            FontSize="10"
                            Text="+ NOVO VEÍCULO"
                            TextColor="White" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Veiculos}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="14"
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="7">
                                            <Label>
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span
                                                            FontFamily="PoppinsSemiBold"
                                                            FontSize="14"
                                                            Text="{Binding Codigo}"
                                                            TextColor="#0F172A" />
                                                        <Span
                                                            FontSize="13"
                                                            Text=" • "
                                                            TextColor="#64748B" />
                                                        <Span
                                                            FontFamily="PoppinsSemiBold"
                                                            FontSize="13"
                                                            Text="{Binding Modelo}"
                                                            TextColor="#0F172A" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <Label FontSize="11" TextColor="#64748B">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Capacidade: " />
                                                        <Span
                                                            FontFamily="PoppinsSemiBold"
                                                            Text="{Binding Capacidade}"
                                                            TextColor="#334155" />
                                                        <Span Text=" • Hodômetro: " />
                                                        <Span
                                                            FontFamily="PoppinsSemiBold"
                                                            Text="{Binding Hodometro}"
                                                            TextColor="#334155" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="1"
                                            Padding="16,10"
                                            BackgroundColor="#F8FAFC"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <Label
                                                FontFamily="PoppinsSemiBold"
                                                FontSize="10"
                                                Text="{Binding Status}"
                                                TextColor="{Binding StatusCor}"
                                                VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!--  ROTAS PADRÃO  -->
                <VerticalStackLayout
                    x:Name="ConteudoRotas"
                    IsVisible="False"
                    Spacing="16">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            FontFamily="PoppinsSemiBold"
                            FontSize="15"
                            Text="Trechos e Rotas Padrão"
                            TextColor="#475569"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="1"
                            Padding="12,5"
                            BackgroundColor="#1675F8"
                            Clicked="OnNovaRotaClicked"
                            CornerRadius="18"
                            FontFamily="PoppinsSemiBold"
                            FontSize="10"
                            Text="+ NOVA ROTA"
                            TextColor="White" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rotas}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="14"
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1">
                                    <VerticalStackLayout>
                                        <Label
                                            FontFamily="PoppinsSemiBold"
                                            FontSize="13"
                                            Text="{Binding Trecho}"
                                            TextColor="#0F172A" />

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="5">
                                                <Label FontSize="11" TextColor="#64748B">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Distância Padrão: " />
                                                            <Span
                                                                FontFamily="PoppinsSemiBold"
                                                                Text="{Binding Distancia}"
                                                                TextColor="#334155" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    FontFamily="PoppinsSemiBold"
                                                    FontSize="11"
                                                    Text="{Binding StatusTexto}"
                                                    TextColor="{Binding StatusCor}" />
                                            </VerticalStackLayout>

                                            <Button
                                                Grid.Column="1"
                                                Padding="12,0"
                                                BackgroundColor="{Binding AcaoCor}"
                                                Command="{Binding AlternarCommand}"
                                                CornerRadius="12"
                                                FontFamily="PoppinsSemiBold"
                                                FontSize="10"
                                                HeightRequest="36"
                                                Text="{Binding AcaoTexto}"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!--  PLANOS E REVISÕES  -->
                <VerticalStackLayout
                    x:Name="ConteudoPlanos"
                    IsVisible="False"
                    Spacing="16">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            FontFamily="PoppinsSemiBold"
                            FontSize="14"
                            Text="Gatilhos Preventivos por KM"
                            TextColor="#475569"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="1"
                            Padding="12,5"
                            BackgroundColor="#1675F8"
                            Clicked="OnRegistrarServicoClicked"
                            CornerRadius="18"
                            FontFamily="PoppinsSemiBold"
                            FontSize="10"
                            Text="+ RESGISTRAR SERVIÇO"
                            TextColor="White" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Planos}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="12"
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1">

                                    <Grid ColumnDefinitions="3,*" ColumnSpacing="10">
                                        <BoxView
                                            Grid.Column="0"
                                            VerticalOptions="Fill"
                                            Color="#F59E0B" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="7">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <Label
                                                    FontFamily="PoppinsSemiBold"
                                                    FontSize="12"
                                                    Text="{Binding Titulo}"
                                                    TextColor="#0F172A"
                                                    VerticalOptions="Center" />

                                                <Border
                                                    Grid.Column="1"
                                                    Padding="7,4"
                                                    BackgroundColor="#FFEDD5"
                                                    StrokeShape="RoundRectangle 12"
                                                    StrokeThickness="0"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        FontFamily="PoppinsSemiBold"
                                                        FontSize="9"
                                                        TextColor="#C2410C">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Alvo: " />
                                                                <Span Text="{Binding KmAlvo}" />
                                                                <Span Text=" KM" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </Border>
                                            </Grid>

                                            <Label FontSize="11" TextColor="#64748B">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Veículo: " />
                                                        <Span FontFamily="PoppinsSemiBold" Text="{Binding Veiculo}" />
                                                        <Span Text=" (Atual: " />
                                                        <Span Text="{Binding KmAtual}" />
                                                        <Span Text=" KM) • Faltam " />
                                                        <Span FontFamily="PoppinsSemiBold" Text="{Binding KmFaltantes}" />
                                                        <Span Text=" KM" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label
                        FontFamily="PoppinsSemiBold"
                        FontSize="13"
                        Text="Histórico de Serviços Realizados"
                        TextColor="#334155" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Historico}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="13"
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 15"
                                    StrokeThickness="1">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="6">
                                            <Label
                                                FontFamily="PoppinsSemiBold"
                                                FontSize="12"
                                                Text="{Binding Titulo}"
                                                TextColor="#0F172A" />
                                            <Label
                                                FontSize="10"
                                                Text="{Binding Descricao}"
                                                TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            FontFamily="PoppinsBold"
                                            FontSize="11"
                                            Text="{Binding Valor}"
                                            TextColor="#EF4444"
                                            VerticalOptions="Start" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
