<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.GestorFrotasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Gestor de Frotas"
    BackgroundColor="#F8F8F8"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="85,65,*" RowSpacing="0">

        <!--  CABEÇALHO  -->
        <Grid
            Grid.Row="0"
            Padding="20,8,15,8"
            ColumnDefinitions="*"
            HeightRequest="85">

            <Grid.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#2C63B1" />
                    <GradientStop Offset="1" Color="#1EA1E8" />
                </LinearGradientBrush>
            </Grid.Background>

            <Label
                FontFamily="PoppinsSemiBold"
                FontSize="22"
                Text="Controle de Rotas"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>

        <!--  ABAS  -->
        <Grid
            Grid.Row="1"
            Padding="10,8"
            BackgroundColor="#F8F8F8"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="6">

            <Border
                x:Name="AbaVeiculos"
                Grid.Column="0"
                Padding="3,5"
                BackgroundColor="#1D61D2"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVeiculosTapped" />
                </Border.GestureRecognizers>
                <Label
                    FontFamily="PoppinsSemiBold"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Veículos"
                    TextColor="White"
                    VerticalTextAlignment="Center" />
            </Border>

            <Border
                x:Name="AbaRotas"
                Grid.Column="1"
                Padding="3,5"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRotasTapped" />
                </Border.GestureRecognizers>
                <Label
                    FontFamily="PoppinsMedium"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Rotas Padrão"
                    TextColor="#64748B"
                    VerticalTextAlignment="Center" />
            </Border>

            <Border
                x:Name="AbaPlanos"
                Grid.Column="2"
                Padding="3,5"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPlanosTapped" />
                </Border.GestureRecognizers>
                <Label
                    FontFamily="PoppinsMedium"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Revisões"
                    TextColor="#64748B"
                    VerticalTextAlignment="Center" />
            </Border>
        </Grid>

        <!--  CONTEÚDO + FADE NO TOPO  -->
        <Grid Grid.Row="2">

            <ScrollView>
                <Grid Padding="16,16,16,24">

                    <!--  VEÍCULOS  -->
                    <VerticalStackLayout x:Name="ConteudoVeiculos" Spacing="16">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label
                                FontFamily="PoppinsSemiBold"
                                FontSize="18"
                                Text="Caminhões Cadastrados"
                                TextColor="#0F172A"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="1"
                                Padding="14,0"
                                BackgroundColor="#1D61D2"
                                Clicked="OnNovoVeiculoClicked"
                                CornerRadius="12"
                                FontFamily="PoppinsSemiBold"
                                FontSize="11"
                                HeightRequest="40"
                                Text="+ NOVO VEÍCULO"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="16">
                            <Border Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.06" Radius="3" Offset="0,1" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="8">
                                        <Label>
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span FontFamily="PoppinsSemiBold" FontSize="16" Text="NV-2026" TextColor="#0F172A" />
                                                    <Span FontFamily="PoppinsRegular" FontSize="14" Text=" • " TextColor="#64748B" />
                                                    <Span FontFamily="PoppinsSemiBold" FontSize="14" Text="Volvo FH 540 6x4" TextColor="#0F172A" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontFamily="PoppinsRegular" FontSize="13" TextColor="#64748B">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Capacidade: " />
                                                    <Span FontFamily="PoppinsSemiBold" Text="32 toneladas" TextColor="#475569" />
                                                    <Span Text=" • Hodômetro: " />
                                                    <Span FontFamily="PoppinsSemiBold" Text="158.400 KM" TextColor="#475569" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Padding="10,5" BackgroundColor="#FFF7ED" StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Start">
                                        <Label FontFamily="PoppinsSemiBold" FontSize="12" Text="Em viagem" TextColor="#F59E0B" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.06" Radius="3" Offset="0,1" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="8">
                                        <Label>
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span FontFamily="PoppinsSemiBold" FontSize="16" Text="DAF-7788" TextColor="#0F172A" />
                                                    <Span FontFamily="PoppinsRegular" FontSize="14" Text=" • " TextColor="#64748B" />
                                                    <Span FontFamily="PoppinsSemiBold" FontSize="14" Text="DAF XF 530" TextColor="#0F172A" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontFamily="PoppinsRegular" FontSize="13" TextColor="#64748B">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Capacidade: " />
                                                    <Span FontFamily="PoppinsSemiBold" Text="30 toneladas" TextColor="#475569" />
                                                    <Span Text=" • Hodômetro: " />
                                                    <Span FontFamily="PoppinsSemiBold" Text="59.200 KM" TextColor="#475569" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Padding="10,5" BackgroundColor="#F0FDF4" StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Start">
                                        <Label FontFamily="PoppinsSemiBold" FontSize="12" Text="Disponível" TextColor="#15803D" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!--  ROTAS PADRÃO  -->
                    <VerticalStackLayout
                        x:Name="ConteudoRotas"
                        IsVisible="False"
                        Spacing="16">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label
                                FontFamily="PoppinsSemiBold"
                                FontSize="18"
                                Text="Trechos e Rotas Padrão"
                                TextColor="#0F172A"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="1"
                                Padding="14,0"
                                BackgroundColor="#1D61D2"
                                Clicked="OnNovaRotaClicked"
                                CornerRadius="12"
                                FontFamily="PoppinsSemiBold"
                                FontSize="11"
                                HeightRequest="40"
                                Text="+ NOVA ROTA"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="16">
                            <!-- ROTA 1 -->
                            <Border Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.06" Radius="3" Offset="0,1" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="10">
                                    <Label FontFamily="PoppinsSemiBold" FontSize="15" Text="Sete Lagoas - MG → Santana - BA" TextColor="#0F172A" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label FontFamily="PoppinsRegular" FontSize="13" TextColor="#64748B">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Distância Padrão: " />
                                                        <Span FontFamily="PoppinsSemiBold" Text="980 KM" TextColor="#475569" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontFamily="PoppinsSemiBold" FontSize="12" Text="Rota ativa" TextColor="#16A34A">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference SwitchRota1}, Path=IsToggled}" Value="False">
                                                        <Setter Property="Text" Value="Rota inativa" />
                                                        <Setter Property="TextColor" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                                            <Switch x:Name="SwitchRota1" IsToggled="True" OnColor="#16A34A" ThumbColor="White" HorizontalOptions="Center" />
                                            <Label FontFamily="PoppinsSemiBold" FontSize="10" Text="ATIVA" TextColor="#16A34A" HorizontalTextAlignment="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference SwitchRota1}, Path=IsToggled}" Value="False">
                                                        <Setter Property="Text" Value="INATIVA" />
                                                        <Setter Property="TextColor" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- ROTA 2 -->
                            <Border Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.06" Radius="3" Offset="0,1" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="10">
                                    <Label FontFamily="PoppinsSemiBold" FontSize="15" Text="Varginha - MG → Três Pontas - MG" TextColor="#0F172A" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label FontFamily="PoppinsRegular" FontSize="13" TextColor="#64748B">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Distância Padrão: " />
                                                        <Span FontFamily="PoppinsSemiBold" Text="28 KM" TextColor="#475569" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontFamily="PoppinsSemiBold" FontSize="12" Text="Rota ativa" TextColor="#16A34A">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference SwitchRota2}, Path=IsToggled}" Value="False">
                                                        <Setter Property="Text" Value="Rota inativa" />
                                                        <Setter Property="TextColor" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                                            <Switch x:Name="SwitchRota2" IsToggled="True" OnColor="#16A34A" ThumbColor="White" HorizontalOptions="Center" />
                                            <Label FontFamily="PoppinsSemiBold" FontSize="10" Text="ATIVA" TextColor="#16A34A" HorizontalTextAlignment="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference SwitchRota2}, Path=IsToggled}" Value="False">
                                                        <Setter Property="Text" Value="INATIVA" />
                                                        <Setter Property="TextColor" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!--  PLANOS E REVISÕES  -->
                    <VerticalStackLayout
                        x:Name="ConteudoPlanos"
                        IsVisible="False"
                        Spacing="16">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label
                                FontFamily="PoppinsSemiBold"
                                FontSize="18"
                                Text="Gatilhos Preventivos por KM"
                                TextColor="#0F172A"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="1"
                                Padding="14,0"
                                BackgroundColor="#1D61D2"
                                Clicked="OnRegistrarServicoClicked"
                                CornerRadius="12"
                                FontFamily="PoppinsSemiBold"
                                FontSize="11"
                                HeightRequest="40"
                                Text="+ REGISTRAR SERVIÇO"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="16">
                            <Border Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.06" Radius="3" Offset="0,1" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="4,*" ColumnSpacing="12">
                                    <BoxView Grid.Column="0" CornerRadius="2" VerticalOptions="Fill" Color="#B45309" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label FontFamily="PoppinsSemiBold" FontSize="15" Text="Revisão preventiva - Volvo FH 540" TextColor="#0F172A" VerticalOptions="Center" />
                                            <Border Grid.Column="1" Padding="10,5" BackgroundColor="#FFEDD5" StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Center">
                                                <Label FontFamily="PoppinsSemiBold" FontSize="12" Text="Alvo: 160.000 KM" TextColor="#C2410C" />
                                            </Border>
                                        </Grid>
                                        <Label FontFamily="PoppinsRegular" FontSize="13" TextColor="#64748B">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Veículo: " />
                                                    <Span FontFamily="PoppinsSemiBold" Text="NV-2026" />
                                                    <Span Text=" (Atual: 158.400 KM) • Faltam " />
                                                    <Span FontFamily="PoppinsSemiBold" Text="1.600" />
                                                    <Span Text=" KM" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <Border Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.06" Radius="3" Offset="0,1" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="4,*" ColumnSpacing="12">
                                    <BoxView Grid.Column="0" CornerRadius="2" VerticalOptions="Fill" Color="#B45309" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label FontFamily="PoppinsSemiBold" FontSize="15" Text="Revisão de 60 mil KM - DAF XF 530" TextColor="#0F172A" VerticalOptions="Center" />
                                            <Border Grid.Column="1" Padding="10,5" BackgroundColor="#FFEDD5" StrokeShape="RoundRectangle 8" StrokeThickness="0" VerticalOptions="Center">
                                                <Label FontFamily="PoppinsSemiBold" FontSize="12" Text="Alvo: 60.000 KM" TextColor="#C2410C" />
                                            </Border>
                                        </Grid>
                                        <Label FontFamily="PoppinsRegular" FontSize="13" TextColor="#64748B">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Veículo: " />
                                                    <Span FontFamily="PoppinsSemiBold" Text="DAF-7788" />
                                                    <Span Text=" (Atual: 59.200 KM) • Faltam " />
                                                    <Span FontFamily="PoppinsSemiBold" Text="800" />
                                                    <Span Text=" KM" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Label
                            FontFamily="PoppinsSemiBold"
                            FontSize="16"
                            Text="Histórico de Serviços Realizados"
                            TextColor="#0F172A" />

                        <VerticalStackLayout Spacing="16">
                            <Border Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.06" Radius="3" Offset="0,1" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="6">
                                        <Label FontFamily="PoppinsSemiBold" FontSize="15" Text="Troca de óleo e filtros" TextColor="#0F172A" />
                                        <Label FontFamily="PoppinsRegular" FontSize="13" Text="NV-2026 • Serviço realizado aos 150.000 KM" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" FontFamily="PoppinsBold" FontSize="14" Text="R$ 850,00" TextColor="#EF4444" VerticalOptions="Start" />
                                </Grid>
                            </Border>
                            <Border Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.06" Radius="3" Offset="0,1" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="6">
                                        <Label FontFamily="PoppinsSemiBold" FontSize="15" Text="Revisão geral" TextColor="#0F172A" />
                                        <Label FontFamily="PoppinsRegular" FontSize="13" Text="DAF-7788 • Revisão realizada aos 50.000 KM" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" FontFamily="PoppinsBold" FontSize="14" Text="R$ 1.200,00" TextColor="#EF4444" VerticalOptions="Start" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>

            <!--  FADE no topo  -->
            <BoxView
                HeightRequest="16"
                InputTransparent="True"
                VerticalOptions="Start">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#F8F8F8" />
                        <GradientStop Offset="1.0" Color="#00F8F8F8" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
        </Grid>

    </Grid>
</ContentPage>