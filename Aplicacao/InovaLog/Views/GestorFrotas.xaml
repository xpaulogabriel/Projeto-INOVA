<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.GestorFrotasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:InovaLog.ViewModels"
    Title="Gestor de Frotas"
    x:DataType="vm:GestorFrotasViewModel"
    BackgroundColor="#F8F8F8"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="85,65,*" RowSpacing="0">

        <!--  CABEÇALHO  -->
        <Grid
            Grid.Row="0"
            Padding="20,8,15,8"
            ColumnDefinitions="*,Auto">

            <Grid.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#2C63B1" />
                    <GradientStop Offset="1" Color="#1EA1E8" />
                </LinearGradientBrush>
            </Grid.Background>

            <Label
                FontFamily="PoppinsSemiBold"
                FontSize="19"
                Text="Frota, Rotas &amp; Manutenção"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>

        <!--  ABAS  -->
        <Grid
            Grid.Row="1"
            Padding="10,8"
            BackgroundColor="#F8F8F8"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="6">

            <Border
                x:Name="AbaVeiculos"
                Grid.Column="0"
                Padding="3,5"
                BackgroundColor="#1D61D2"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVeiculosTapped" />
                </Border.GestureRecognizers>
                <Label
                    FontFamily="PoppinsSemiBold"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Veículos"
                    TextColor="White"
                    VerticalTextAlignment="Center" />
            </Border>

            <Border
                x:Name="AbaRotas"
                Grid.Column="1"
                Padding="3,5"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRotasTapped" />
                </Border.GestureRecognizers>
                <Label
                    FontFamily="PoppinsMedium"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Rotas Padrão"
                    TextColor="#64748B"
                    VerticalTextAlignment="Center" />
            </Border>

            <Border
                x:Name="AbaPlanos"
                Grid.Column="2"
                Padding="3,5"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1"
                VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPlanosTapped" />
                </Border.GestureRecognizers>
                <Label
                    FontFamily="PoppinsMedium"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Revisões"
                    TextColor="#64748B"
                    VerticalTextAlignment="Center" />
            </Border>
        </Grid>

        <!--  CONTEÚDO + FADE NO TOPO  -->
        <Grid Grid.Row="2">

            <ScrollView>
                <Grid Padding="16,16,16,24">

                    <!--  VEÍCULOS  -->
                    <VerticalStackLayout x:Name="ConteudoVeiculos" Spacing="16">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label
                                FontFamily="PoppinsSemiBold"
                                FontSize="18"
                                Text="Caminhões Cadastrados"
                                TextColor="#0F172A"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="1"
                                Padding="14,0"
                                BackgroundColor="#1D61D2"
                                Clicked="OnNovoVeiculoClicked"
                                CornerRadius="12"
                                FontFamily="PoppinsSemiBold"
                                FontSize="11"
                                HeightRequest="40"
                                Text="+ NOVO VEÍCULO"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Veiculos}" Spacing="16">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="16"
                                        BackgroundColor="White"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="1">
                                        <Border.Shadow>
                                            <Shadow
                                                Brush="Black"
                                                Offset="0,1"
                                                Opacity="0.06"
                                                Radius="3" />
                                        </Border.Shadow>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="8">
                                                <Label>
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                FontFamily="PoppinsSemiBold"
                                                                FontSize="16"
                                                                Text="{Binding Codigo}"
                                                                TextColor="#0F172A" />
                                                            <Span
                                                                FontFamily="PoppinsRegular"
                                                                FontSize="14"
                                                                Text=" • "
                                                                TextColor="#64748B" />
                                                            <Span
                                                                FontFamily="PoppinsSemiBold"
                                                                FontSize="14"
                                                                Text="{Binding Modelo}"
                                                                TextColor="#0F172A" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    FontFamily="PoppinsRegular"
                                                    FontSize="13"
                                                    TextColor="#64748B">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Capacidade: " />
                                                            <Span
                                                                FontFamily="PoppinsSemiBold"
                                                                Text="{Binding Capacidade}"
                                                                TextColor="#475569" />
                                                            <Span Text=" • Hodômetro: " />
                                                            <Span
                                                                FontFamily="PoppinsSemiBold"
                                                                Text="{Binding Hodometro}"
                                                                TextColor="#475569" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>

                                            <Border
                                                Grid.Column="1"
                                                Padding="10,5"
                                                BackgroundColor="#F8FAFC"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                VerticalOptions="Start">
                                                <Label
                                                    FontFamily="PoppinsSemiBold"
                                                    FontSize="12"
                                                    Text="{Binding Status}"
                                                    TextColor="{Binding StatusCor}"
                                                    VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!--  ROTAS PADRÃO  -->
                    <VerticalStackLayout
                        x:Name="ConteudoRotas"
                        IsVisible="False"
                        Spacing="16">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label
                                FontFamily="PoppinsSemiBold"
                                FontSize="18"
                                Text="Trechos e Rotas Padrão"
                                TextColor="#0F172A"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="1"
                                Padding="14,0"
                                BackgroundColor="#1D61D2"
                                Clicked="OnNovaRotaClicked"
                                CornerRadius="12"
                                FontFamily="PoppinsSemiBold"
                                FontSize="11"
                                HeightRequest="40"
                                Text="+ NOVA ROTA"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rotas}" Spacing="16">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="16"
                                        BackgroundColor="White"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="1">
                                        <Border.Shadow>
                                            <Shadow
                                                Brush="Black"
                                                Offset="0,1"
                                                Opacity="0.06"
                                                Radius="3" />
                                        </Border.Shadow>

                                        <VerticalStackLayout Spacing="10">
                                            <Label
                                                FontFamily="PoppinsSemiBold"
                                                FontSize="15"
                                                Text="{Binding Trecho}"
                                                TextColor="#0F172A" />

                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="6">
                                                    <Label
                                                        FontFamily="PoppinsRegular"
                                                        FontSize="13"
                                                        TextColor="#64748B">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Distância Padrão: " />
                                                                <Span
                                                                    FontFamily="PoppinsSemiBold"
                                                                    Text="{Binding Distancia}"
                                                                    TextColor="#475569" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>

                                                    <Label
                                                        FontFamily="PoppinsSemiBold"
                                                        FontSize="12"
                                                        Text="{Binding StatusTexto}"
                                                        TextColor="{Binding StatusCor}" />
                                                </VerticalStackLayout>

                                                <Button
                                                    Grid.Column="1"
                                                    Padding="14,0"
                                                    BackgroundColor="{Binding AcaoCor}"
                                                    Command="{Binding AlternarCommand}"
                                                    CornerRadius="12"
                                                    FontFamily="PoppinsSemiBold"
                                                    FontSize="11"
                                                    HeightRequest="40"
                                                    Text="{Binding AcaoTexto}"
                                                    TextColor="White"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!--  PLANOS E REVISÕES  -->
                    <VerticalStackLayout
                        x:Name="ConteudoPlanos"
                        IsVisible="False"
                        Spacing="16">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label
                                FontFamily="PoppinsSemiBold"
                                FontSize="18"
                                Text="Gatilhos Preventivos por KM"
                                TextColor="#0F172A"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="1"
                                Padding="14,0"
                                BackgroundColor="#1D61D2"
                                Clicked="OnRegistrarServicoClicked"
                                CornerRadius="12"
                                FontFamily="PoppinsSemiBold"
                                FontSize="11"
                                HeightRequest="40"
                                Text="+ REGISTRAR SERVIÇO"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Planos}" Spacing="16">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="16"
                                        BackgroundColor="White"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="1">
                                        <Border.Shadow>
                                            <Shadow
                                                Brush="Black"
                                                Offset="0,1"
                                                Opacity="0.06"
                                                Radius="3" />
                                        </Border.Shadow>

                                        <Grid ColumnDefinitions="4,*" ColumnSpacing="12">
                                            <BoxView
                                                Grid.Column="0"
                                                CornerRadius="2"
                                                VerticalOptions="Fill"
                                                Color="#B45309" />

                                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Label
                                                        FontFamily="PoppinsSemiBold"
                                                        FontSize="15"
                                                        Text="{Binding Titulo}"
                                                        TextColor="#0F172A"
                                                        VerticalOptions="Center" />

                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="10,5"
                                                        BackgroundColor="#FFEDD5"
                                                        StrokeShape="RoundRectangle 8"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Center">
                                                        <Label
                                                            FontFamily="PoppinsSemiBold"
                                                            FontSize="12"
                                                            TextColor="#C2410C">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="Alvo: " />
                                                                    <Span Text="{Binding KmAlvo}" />
                                                                    <Span Text=" KM" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </Border>
                                                </Grid>

                                                <Label
                                                    FontFamily="PoppinsRegular"
                                                    FontSize="13"
                                                    TextColor="#64748B">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Veículo: " />
                                                            <Span FontFamily="PoppinsSemiBold" Text="{Binding Veiculo}" />
                                                            <Span Text=" (Atual: " />
                                                            <Span Text="{Binding KmAtual}" />
                                                            <Span Text=" KM) • Faltam " />
                                                            <Span FontFamily="PoppinsSemiBold" Text="{Binding KmFaltantes}" />
                                                            <Span Text=" KM" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label
                            FontFamily="PoppinsSemiBold"
                            FontSize="16"
                            Text="Histórico de Serviços Realizados"
                            TextColor="#0F172A" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Historico}" Spacing="16">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="16"
                                        BackgroundColor="White"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="1">
                                        <Border.Shadow>
                                            <Shadow
                                                Brush="Black"
                                                Offset="0,1"
                                                Opacity="0.06"
                                                Radius="3" />
                                        </Border.Shadow>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="6">
                                                <Label
                                                    FontFamily="PoppinsSemiBold"
                                                    FontSize="15"
                                                    Text="{Binding Titulo}"
                                                    TextColor="#0F172A" />
                                                <Label
                                                    FontFamily="PoppinsRegular"
                                                    FontSize="13"
                                                    Text="{Binding Descricao}"
                                                    TextColor="#64748B" />
                                            </VerticalStackLayout>

                                            <Label
                                                Grid.Column="1"
                                                FontFamily="PoppinsBold"
                                                FontSize="14"
                                                Text="{Binding Valor}"
                                                TextColor="#EF4444"
                                                VerticalOptions="Start" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>

            <!--  FADE no topo  -->
            <BoxView
                HeightRequest="16"
                InputTransparent="True"
                VerticalOptions="Start">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.0" Color="#F8F8F8" />
                        <GradientStop Offset="1.0" Color="#00F8F8F8" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
        </Grid>

    </Grid>
</ContentPage>