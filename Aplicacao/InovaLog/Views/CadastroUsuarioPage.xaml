<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.CadastroUsuarioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="CadastroUsuarioPage"
    BackgroundColor="#F8F8F8">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!--  CABEÇALHO AZUL  -->
        <Grid
            Grid.Row="0"
            Padding="30,10,15,5"
            HeightRequest="85">

            <Grid.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                    <GradientStop Offset="1.0" Color="#1EA1E8" />
                    <GradientStop Offset="0.0" Color="#2C63B1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Label
                FontSize="20"
                HorizontalOptions="Start"
                Text="Novo cadastro de Usuário"
                TextColor="White"
                VerticalOptions="Center" />

            <Image
                HeightRequest="80"
                HorizontalOptions="End"
                Opacity="0.25"
                Source="logo_azul.png"
                VerticalOptions="Center"
                WidthRequest="80" />

        </Grid>



        <!--  FORMULÁRIO  -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="30,20,30,10" Spacing="15">

                <!--  Nome completo  -->

                <Label
                    FontAttributes="Bold"
                    FontSize="15"
                    Text="Nome Completo"
                    TextColor="Black" />

                <Border
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D0D0D0"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1">

                    <Entry
                        FontSize="12"
                        HeightRequest="38"
                        Placeholder="Nome"
                        PlaceholderColor="#A0A0A0"
                        TextColor="Black" />

                </Border>


                <!--  Perfil de acesso  -->

                <Label
                    FontAttributes="Bold"
                    FontSize="15"
                    Text="Perfil de Acesso"
                    TextColor="Black" />

                <Border
                    Padding="8,0"
                    BackgroundColor="White"
                    Stroke="#D0D0D0"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1">

                    <Picker
                        Title="Motorista"
                        FontSize="12"
                        HeightRequest="38"
                        TextColor="Black">

                        <Picker.Items>
                            <x:String>Financeiro</x:String>
                            <x:String>Motorista</x:String>
                        </Picker.Items>

                    </Picker>

                </Border>


                <!--  E-mail  -->

                <Label
                    FontAttributes="Bold"
                    FontSize="15"
                    Text="E-mail Google de Acesso"
                    TextColor="Black" />

                <Border
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D0D0D0"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1">

                    <Entry
                        FontSize="12"
                        HeightRequest="38"
                        Keyboard="Email"
                        Placeholder="E-mail"
                        PlaceholderColor="#A0A0A0"
                        TextColor="Black" />

                </Border>

                <Label
                    Margin="5,-8,0,0"
                    FontAttributes="Italic"
                    FontSize="10"
                    Text="Informe o mesmo contato Google que o usuário usará para logar no sistema"
                    TextColor="#555555" />

                <!--  DADOS DO MOTORISTA  -->
                <Border
                    Margin="0,20,0,0"
                    Padding="10,10"
                    BackgroundColor="#F8F8F8"
                    Stroke="#C8C8C8"
                    StrokeShape="RoundRectangle 5"
                    StrokeThickness="1">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Dados do Motorista"
                            TextColor="Black" />


                        <!--  CPF  -->

                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="CPF"
                            TextColor="Black" />

                        <Border
                            Padding="12,0"
                            BackgroundColor="White"
                            Stroke="#D0D0D0"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="1">

                            <Entry
                                FontSize="12"
                                HeightRequest="35"
                                Keyboard="Numeric"
                                Placeholder="000.000.000-00"
                                PlaceholderColor="#A0A0A0"
                                TextColor="Black" />

                        </Border>


                        <!--  Data de nascimento  -->

                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Data de Nascimento"
                            TextColor="Black" />

                        <Border
                            Padding="12,0"
                            BackgroundColor="White"
                            Stroke="#D0D0D0"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="1">

                            <DatePicker
                                FontSize="12"
                                Format="dd/MM/yyyy"
                                HeightRequest="35"
                                TextColor="#A0A0A0" />

                        </Border>


                        <!--  CNH  -->

                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Nº da CNH"
                            TextColor="Black" />

                        <Border
                            Padding="12,0"
                            BackgroundColor="White"
                            Stroke="#D0D0D0"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="1">

                            <Entry
                                FontSize="12"
                                HeightRequest="35"
                                Keyboard="Numeric"
                                Placeholder="12345678900"
                                PlaceholderColor="#A0A0A0"
                                TextColor="Black" />

                        </Border>


                        <!--  Validade + Categoria  -->

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15">

                            <VerticalStackLayout Grid.Column="0" Spacing="5">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="Validade"
                                    TextColor="Black" />

                                <Border
                                    Padding="10,0"
                                    BackgroundColor="White"
                                    Stroke="#D0D0D0"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="1">

                                    <DatePicker
                                        FontSize="12"
                                        Format="dd/MM/yyyy"
                                        HeightRequest="35"
                                        TextColor="#A0A0A0" />

                                </Border>

                            </VerticalStackLayout>


                            <VerticalStackLayout Grid.Column="1" Spacing="5">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="Categoria"
                                    TextColor="Black" />

                                <Border
                                    Padding="8,0"
                                    BackgroundColor="White"
                                    Stroke="#D0D0D0"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="1">

                                    <Picker
                                        Title="D/E"
                                        FontSize="12"
                                        HeightRequest="35"
                                        TextColor="Black">

                                        <Picker.Items>
                                            <x:String>D</x:String>
                                            <x:String>E</x:String>
                                        </Picker.Items>
                                    </Picker>


                                </Border>

                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!--  RODAPÉ  -->
        <Grid
            Grid.Row="2"
            Margin="5,0"
            Padding="10,5"
            BackgroundColor="White"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8"
            HeightRequest="60">

            <HorizontalStackLayout
                Grid.Column="0"
                Spacing="5"
                VerticalOptions="Center">

                <Switch
                    IsToggled="True"
                    Scale="0.80"
                    VerticalOptions="Center" />

                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    Text="Status de Acesso: Ativo"
                    TextColor="Black"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>


            <Button
                Grid.Column="1"
                Padding="10,0"
                BackgroundColor="White"
                BorderColor="#BDBDBD"
                BorderWidth="1"
                CornerRadius="4"
                FontSize="12"
                HeightRequest="25"
                Text="Cancelar"
                TextColor="#333333" />


            <Button
                Grid.Column="2"
                Padding="10,0"
                BackgroundColor="#2C63B1"
                CornerRadius="4"
                FontSize="12"
                HeightRequest="25"
                Text="Cadastrar"
                TextColor="White" />

        </Grid>

    </Grid>

</ContentPage>