<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.NovaRotaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="NovaRotaPage"
    BackgroundColor="#f8f8f8"
    NavigationPage.HasNavigationBar="False"
    SafeAreaEdges="None">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!--  CABEÇALHO AZUL  -->

        <Grid
            Grid.Row="0"
            Padding="30,10,15,5"
            HeightRequest="85">

            <Grid.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                    <GradientStop Offset="1.0" Color="#1EA1E8" />
                    <GradientStop Offset="0.0" Color="#2C63B1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Label
                FontFamily="PoppinsSemiBold"
                FontSize="20"
                HorizontalOptions="Start"
                Text="Nova Rota "
                TextColor="White"
                VerticalOptions="Center" />

            <Image
                HeightRequest="70"
                HorizontalOptions="End"
                Opacity="0.25"
                Source="logo_azul.png"
                VerticalOptions="Center"
                WidthRequest="70" />

        </Grid>


        <!--  FORMULÁRIO  -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="30,20,30,10" Spacing="15">

                <!--  Origem  -->

                <Label
                    FontAttributes="Bold"
                    FontSize="15"
                    Text="Origem"
                    TextColor="Black" />

                <Border
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D0D0D0"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1">

                    <Entry
                        FontSize="12"
                        HeightRequest="38"
                        Placeholder="Varginha - MG"
                        PlaceholderColor="#A0A0A0"
                        TextColor="Black" />

                </Border>


                <!--  Destino  -->

                <Label
                    FontAttributes="Bold"
                    FontSize="15"
                    Text="Destino"
                    TextColor="Black" />

                <Border
                    Padding="8,0"
                    BackgroundColor="White"
                    Stroke="#D0D0D0"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1">

                    <Entry
                        FontSize="12"
                        HeightRequest="38"
                        Placeholder="Rio de Janeiro - RJ"
                        PlaceholderColor="#A0A0A0"
                        TextColor="Black" />
                </Border>


                <!--  Distância Estimada  -->

                <Label
                    FontAttributes="Bold"
                    FontSize="15"
                    Text="Distância Estimada"
                    TextColor="Black" />

                <Border
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D0D0D0"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1">

                    <Entry
                        FontSize="12"
                        HeightRequest="38"
                        Keyboard="Email"
                        Placeholder="150"
                        PlaceholderColor="#A0A0A0"
                        TextColor="Black" />

                </Border>

                <Label
                    Margin="5,-8,0,0"
                    FontAttributes="Italic"
                    FontSize="10"
                    Text="Por gentileza, digite a distância em quilômetros (km)."
                    TextColor="#555555" />


            </VerticalStackLayout>

        </ScrollView>

        <!--  RODAPÉ  -->
        <Grid
            Grid.Row="2"
            Margin="5,0"
            Padding="10,5"
            BackgroundColor="White"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8"
            HeightRequest="60">

            <HorizontalStackLayout
                Grid.Column="0"
                Spacing="5"
                VerticalOptions="Center">

                <Switch
                    IsToggled="True"
                    Scale="0.80"
                    VerticalOptions="Center" />

                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    Text="Status de Acesso: Ativo"
                    TextColor="Black"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>


            <Button
                Grid.Column="1"
                Padding="10,0"
                BackgroundColor="White"
                BorderColor="#BDBDBD"
                BorderWidth="1"
                CornerRadius="4"
                FontSize="12"
                HeightRequest="25"
                Text="Cancelar"
                TextColor="#333333" />


            <Button
                Grid.Column="2"
                Padding="10,0"
                BackgroundColor="#2C63B1"
                CornerRadius="4"
                FontSize="12"
                HeightRequest="25"
                Text="Cadastrar"
                TextColor="White" />

        </Grid>

    </Grid>


</ContentPage>