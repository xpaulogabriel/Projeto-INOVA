<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.NovaRotaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Nova Rota"
    BackgroundColor="#F8F8F8"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior
            StatusBarColor="#2C63B1"
            StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!-- CABEÇALHO -->
        <Grid
            Grid.Row="0"
            Padding="20,8,15,8"
            HeightRequest="85">

            <Grid.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="#2C63B1" />
                    <GradientStop Offset="1.0" Color="#1EA1E8" />
                </LinearGradientBrush>
            </Grid.Background>

            <Label
                FontFamily="PoppinsSemiBold"
                FontSize="22"
                HorizontalOptions="Start"
                Text="Nova Rota"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>

        <!-- FORMULÁRIO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="20,20,20,25"
                Spacing="0">

                <Label
                    FontFamily="PoppinsSemiBold"
                    FontSize="19"
                    Text="Dados da Rota"
                    TextColor="#0F172A" />

                <Label
                    Margin="0,5,0,25"
                    FontFamily="PoppinsRegular"
                    FontSize="13"
                    Text="Preencha a origem, o destino e a distância estimada do trecho."
                    TextColor="#64748B" />

                <!-- ORIGEM -->
                <HorizontalStackLayout Spacing="8">
                    <Ellipse
                        Fill="#E66D17"
                        HeightRequest="11"
                        WidthRequest="11"
                        VerticalOptions="Center" />

                    <Label
                        FontFamily="PoppinsSemiBold"
                        FontSize="15"
                        Text="Origem"
                        TextColor="#0F172A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Margin="0,5,0,25"
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D1D5DB"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="1">

                    <Entry
                        x:Name="TxtOrigem"
                        BackgroundColor="Transparent"
                        ClearButtonVisibility="WhileEditing"
                        FontFamily="PoppinsRegular"
                        FontSize="14"
                        Placeholder="Informe a origem"
                        PlaceholderColor="#94A3B8"
                        TextColor="#334155" />
                </Border>

                <!-- DESTINO -->
                <HorizontalStackLayout Spacing="8">
                    <Ellipse
                        Fill="#E66D17"
                        HeightRequest="11"
                        WidthRequest="11"
                        VerticalOptions="Center" />

                    <Label
                        FontFamily="PoppinsSemiBold"
                        FontSize="15"
                        Text="Destino"
                        TextColor="#0F172A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Margin="0,5,0,25"
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D1D5DB"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="1">

                    <Entry
                        x:Name="TxtDestino"
                        BackgroundColor="Transparent"
                        ClearButtonVisibility="WhileEditing"
                        FontFamily="PoppinsRegular"
                        FontSize="14"
                        Placeholder="Informe o destino"
                        PlaceholderColor="#94A3B8"
                        TextColor="#334155" />
                </Border>

                <!-- DISTÂNCIA ESTIMADA -->
                <HorizontalStackLayout Spacing="8">
                    <Ellipse
                        Fill="#E66D17"
                        HeightRequest="11"
                        WidthRequest="11"
                        VerticalOptions="Center" />

                    <Label
                        FontFamily="PoppinsSemiBold"
                        FontSize="15"
                        Text="Distância Estimada"
                        TextColor="#0F172A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border
                    Margin="0,5,0,10"
                    Padding="12,0"
                    BackgroundColor="White"
                    Stroke="#D1D5DB"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="1">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">

                        <Entry
                            x:Name="TxtDistancia"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            FontFamily="PoppinsRegular"
                            FontSize="14"
                            Keyboard="Numeric"
                            Placeholder="Ex.: 250"
                            PlaceholderColor="#94A3B8"
                            TextColor="#334155" />

                        <Label
                            Grid.Column="1"
                            Margin="0,0,5,0"
                            FontFamily="PoppinsSemiBold"
                            FontSize="14"
                            Text="km"
                            TextColor="#64748B"
                            VerticalOptions="Center" />

                    </Grid>
                </Border>

                <!-- AVISO DE PREENCHIMENTO -->
                <Label
                    Margin="0,5,0,0"
                    FontFamily="PoppinsSemiBold"
                    FontSize="11"
                    Text="TODOS OS DADOS SÃO OBRIGATÓRIOS"
                    TextColor="#E66D17" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- RODAPÉ FIXO -->
        <Grid
            Grid.Row="2"
            Padding="16,12"
            BackgroundColor="White"
            ColumnDefinitions="*,*"
            ColumnSpacing="12">

            <Button
                Grid.Column="0"
                Padding="12,0"
                BackgroundColor="White"
                BorderColor="#D1D5DB"
                BorderWidth="1"
                Clicked="OnCancelarClicked"
                CornerRadius="9"
                FontFamily="PoppinsSemiBold"
                FontSize="12"
                HeightRequest="44"
                Text="CANCELAR"
                TextColor="#334155" />

            <Button
                Grid.Column="1"
                Padding="12,0"
                BackgroundColor="#2C63B1"
                Clicked="OnSalvarClicked"
                CornerRadius="9"
                FontFamily="PoppinsSemiBold"
                FontSize="12"
                HeightRequest="44"
                Text="SALVAR"
                TextColor="White" />

        </Grid>

    </Grid>
</ContentPage>
