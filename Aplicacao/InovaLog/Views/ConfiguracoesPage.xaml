<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InovaLog.Views.ConfiguracoesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:InovaLog.ViewModels"
    Title="Configurações"
    BackgroundColor="#F8F8F8">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#2C63B1" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,Auto,*">

        <!--  CABEÇALHO AZUL  -->
        <Grid Grid.Row="0" Padding="24,10,15,5" HeightRequest="85">
            <Grid.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                    <GradientStop Offset="1.0" Color="#1EA1E8" />
                    <GradientStop Offset="0.0" Color="#2C63B1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Label FontFamily="PoppinsSemiBold" FontSize="20" HorizontalOptions="Start" Text="Configurações" TextColor="White" VerticalOptions="Center" />
            <Image HeightRequest="80" HorizontalOptions="End" Opacity="0.25" Source="logo_azul.png" VerticalOptions="Center" WidthRequest="80" />
        </Grid>

        <!--  BARRA DE ABAS  -->
        <HorizontalStackLayout x:Name="BarraAbas" Grid.Row="1" Padding="18,14,18,6" Spacing="10">
            <Border x:Name="AbaUsuarios" Padding="16,8" BackgroundColor="#1EA1E8" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAbaUsuariosTapped" />
                </Border.GestureRecognizers>
                <Label FontFamily="PoppinsSemiBold" FontSize="13" Text="Usuários" TextColor="White" />
            </Border>

            <Border x:Name="AbaCategorias" Padding="16,8" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAbaCategoriasTapped" />
                </Border.GestureRecognizers>
                <Label FontFamily="PoppinsMedium" FontSize="13" Text="Categorias" TextColor="#64748B" />
            </Border>

            <Border x:Name="AbaPagamentos" Padding="16,8" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 20" StrokeThickness="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAbaPagamentosTapped" />
                </Border.GestureRecognizers>
                <Label FontFamily="PoppinsMedium" FontSize="13" Text="Pagamentos" TextColor="#64748B" />
            </Border>
        </HorizontalStackLayout>

        <!--  CONTEÚDO DAS ABAS  -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="18,10,18,30" Spacing="16">

                <!--  ABA 1: USUÁRIOS  -->
                <VerticalStackLayout x:Name="ConteudoUsuarios" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label FontFamily="PoppinsSemiBold" FontSize="16" Text="Colaboradores Cadastrados" TextColor="#0F172A" />
                            <Label FontFamily="PoppinsRegular" FontSize="12" Text="Gerencie os acessos ativos no InovaLog." TextColor="#64748B" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Padding="14,0"
                            BackgroundColor="#2C63B1"
                            Command="{Binding NovoUsuarioCommand}"
                            CornerRadius="10"
                            FontFamily="PoppinsSemiBold"
                            FontSize="12"
                            HeightRequest="36"
                            Text="+ NOVO"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Grid>

                    <ActivityIndicator Color="#2C63B1" IsRunning="{Binding Carregando}" IsVisible="{Binding Carregando}" />

                    <CollectionView ItemsSource="{Binding Usuarios}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UsuarioItem">
                                <Border Padding="14" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                        <Label Grid.Row="0" Grid.Column="0" FontFamily="PoppinsSemiBold" FontSize="14" Text="{Binding NomeExibicao}" TextColor="#0F172A" />

                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Padding="12,0"
                                            BackgroundColor="{Binding CorFundoAcao}"
                                            Clicked="OnAlternarStatusUsuarioClicked"
                                            CornerRadius="8"
                                            FontFamily="PoppinsSemiBold"
                                            FontSize="11"
                                            HeightRequest="30"
                                            Text="{Binding TextoAcao}"
                                            TextColor="{Binding CorTextoAcao}" />

                                        <Border Grid.Row="1" Grid.Column="0" Padding="8,2" BackgroundColor="#E0F2FE" HorizontalOptions="Start" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                            <Label FontFamily="PoppinsSemiBold" FontSize="10" Text="{Binding RotuloPerfil}" TextColor="#2C63B1" />
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Padding="8,2" BackgroundColor="{Binding CorFundoStatus}" HorizontalOptions="End" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                            <Label FontFamily="PoppinsSemiBold" FontSize="10" Text="{Binding TextoStatus}" TextColor="{Binding CorTextoStatus}" />
                                        </Border>

                                        <Label Grid.Row="2" Grid.ColumnSpan="2" FontFamily="PoppinsRegular" FontSize="12" Text="{Binding Email}" TextColor="#475569" />

                                        <Label Grid.Row="3" Grid.ColumnSpan="2" FontFamily="PoppinsRegular" FontSize="11" IsVisible="{Binding TemDocumentos}" Text="{Binding Documentos}" TextColor="#64748B" />

                                        <!--  AÇÕES: INSPECIONAR E EDITAR  -->
                                        <HorizontalStackLayout Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0" Spacing="8">
                                            <Button
                                                Padding="12,0"
                                                BackgroundColor="#F1F5F9"
                                                Clicked="OnInspecionarUsuarioClicked"
                                                CornerRadius="6"
                                                FontFamily="PoppinsSemiBold"
                                                FontSize="11"
                                                HeightRequest="30"
                                                Text="Inspecionar"
                                                TextColor="#334155" />

                                            <Button
                                                Padding="12,0"
                                                BackgroundColor="#E0F2FE"
                                                Clicked="OnEditarUsuarioClicked"
                                                CornerRadius="6"
                                                FontFamily="PoppinsSemiBold"
                                                FontSize="11"
                                                HeightRequest="30"
                                                Text="Editar"
                                                TextColor="#2C63B1" />
                                            <Button
    Padding="12,0"
    BackgroundColor="#FEE2E2"
    Clicked="OnExcluirUsuarioClicked"
    CornerRadius="6"
    FontFamily="PoppinsSemiBold"
    FontSize="11"
    HeightRequest="30"
    Text="Excluir"
    TextColor="#DC2626" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!--  ABA 2: CATEGORIAS  -->
                <VerticalStackLayout x:Name="ConteudoCategorias" IsVisible="False" Spacing="12">
                    <Label FontFamily="PoppinsSemiBold" FontSize="16" Text="Categorias Financeiras" TextColor="#0F172A" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Border Grid.Column="0" Padding="10,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 10" StrokeThickness="1">
                            <Entry FontSize="12" HeightRequest="38" Placeholder="Nova categoria" Text="{Binding NovaCategoria}" TextColor="Black" />
                        </Border>

                        <Border Grid.Column="1" Padding="6,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 10" StrokeThickness="1">
                            <Picker FontSize="12" HeightRequest="38" SelectedIndex="{Binding TipoCategoriaIndex}" TextColor="Black">
                                <Picker.Items>
                                    <x:String>Entrada</x:String>
                                    <x:String>Saída</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>

                        <Button Grid.Column="2" Padding="12,0" BackgroundColor="#2C63B1" Command="{Binding IncluirCategoriaCommand}" CornerRadius="8" FontSize="12" HeightRequest="38" Text="Incluir" TextColor="White" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Categorias}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoriaItem">
                                <Border Padding="12,10" BackgroundColor="White" Opacity="{Binding OpacidadeLinha}" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10" StrokeThickness="1">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" FontFamily="PoppinsMedium" FontSize="13" Text="{Binding Nome}" TextColor="#0F172A" VerticalOptions="Center" />
                                        <Border Grid.Column="1" Padding="8,3" BackgroundColor="{Binding CorFundoTipo}" StrokeShape="RoundRectangle 6" StrokeThickness="0" VerticalOptions="Center">
                                            <Label FontSize="10" Text="{Binding TipoTexto}" TextColor="{Binding CorTextoTipo}" />
                                        </Border>
                                        <Button Grid.Column="2" Padding="10,0" BackgroundColor="{Binding CorFundoBotao}" Clicked="OnAlternarCategoriaClicked" CornerRadius="6" FontSize="11" HeightRequest="28" Text="{Binding TextoBotao}" TextColor="{Binding CorTextoBotao}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!--  ABA 3: PAGAMENTOS  -->
                <VerticalStackLayout x:Name="ConteudoPagamentos" IsVisible="False" Spacing="12">
                    <Label FontFamily="PoppinsSemiBold" FontSize="16" Text="Formas de Pagamento" TextColor="#0F172A" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Grid.Column="0" Padding="10,0" BackgroundColor="White" Stroke="#D0D0D0" StrokeShape="RoundRectangle 10" StrokeThickness="1">
                            <Entry FontSize="12" HeightRequest="38" Placeholder="Nova forma de pagamento" Text="{Binding NovaFormaPagamento}" TextColor="Black" />
                        </Border>
                        <Button Grid.Column="1" Padding="12,0" BackgroundColor="#2C63B1" Command="{Binding IncluirFormaPagamentoCommand}" CornerRadius="8" FontSize="12" HeightRequest="38" Text="Incluir" TextColor="White" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding FormasPagamento}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FormaPagamentoItem">
                                <Border Padding="12,10" BackgroundColor="White" Opacity="{Binding OpacidadeLinha}" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10" StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAlternarPagamentoTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" FontFamily="PoppinsMedium" FontSize="13" Text="{Binding Nome}" TextColor="#0F172A" VerticalOptions="Center" />
                                        <Border Grid.Column="1" Padding="10,4" BackgroundColor="{Binding CorFundoStatus}" StrokeShape="RoundRectangle 6" StrokeThickness="0" VerticalOptions="Center">
                                            <Label FontSize="11" Text="{Binding TextoStatus}" TextColor="{Binding CorTextoStatus}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!--  MINHA CONTA (Perfis sem abas administrativas)  -->
                <Border x:Name="ConteudoMinhaConta" IsVisible="False" Padding="16" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                    <VerticalStackLayout Spacing="4">
                        <Label FontFamily="PoppinsSemiBold" FontSize="12" Text="MINHA CONTA" TextColor="#64748B" />
                        <Label FontFamily="PoppinsSemiBold" FontSize="16" Text="{Binding NomeConta}" TextColor="#0F172A" />
                        <Label FontFamily="PoppinsRegular" FontSize="13" Text="{Binding EmailConta}" TextColor="#475569" />
                        <Border Margin="0,6,0,0" Padding="10,4" BackgroundColor="#E0F2FE" HorizontalOptions="Start" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                            <Label FontFamily="PoppinsSemiBold" FontSize="11" Text="{Binding RotuloPerfilConta}" TextColor="#2C63B1" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>